---
// 검색 — 먼저 답하는 질문: 검색에서 어떤 글이 찾히고, 무엇을 고치거나 새로 쓸까.
// 왼쪽은 사이트 전체 숫자와 글별 표, 오른쪽 열은 바로 손댈 것(고칠 후보 · 검색어 · 다음 글 후보)
import posts from 'virtual:jd-posts';
import Admin from '../layouts/Admin.astro';
import Kpis from '../components/Kpis.astro';
import Connect from '../components/Connect.astro';
import { loadSearch, searchStats, DAYS, FIX, TOPIC, WINDOW } from '../lib/search';
import { indexGroups, loadIndexing, type Inspection } from '../lib/indexing';
import { delta, md, num, pathOf, pct, postOf, rank, signed, since } from '../lib/format';

const [src, idx] = await Promise.all([loadSearch(), loadIndexing((p) => Astro.locals.cfContext.waitUntil(p))]);
const s = src.state === 'ok' ? searchStats(src.data) : null;

const titleOf = (id: string) => posts.find((p) => p.id === id)?.title ?? `/${id}`;
const PATHS: Record<string, string> = { '/': '홈', '/en': '영어판 홈', '/en/': '영어판 홈' };

// 색인 — 색인 안 된 까닭별 묶음 다음에 색인된 묶음. 줄은 글이면 그 언어판 제목, 아니면 이름 붙인 경로나 경로 그대로
const ix = idx.state === 'ok' ? idx.data : null;
const g = ix && indexGroups(ix);
const groups = g ? [...g.missing.map((m) => ({ label: m.state, urls: m.urls, fail: m.fail })), { label: '색인됨', urls: g.indexed, fail: false }].filter((x) => x.urls.length) : [];
const pageOf = (url: string) => {
  const path = pathOf(url), id = postOf(url), p = id && posts.find((x) => x.id === id);
  return { path, title: p ? (path.startsWith('/en/') ? p.titleEn ?? p.title : p.title) : PATHS[path] ?? path };
};
// 글별 검색 표의 색인 표시(제목 아래 경로 옆) — 한 줄이 한국어판·영어판을 합치니 사이트맵에 있는 언어판을 함께 본다.
// 사이트맵에 없거나 아직 확인 전인 언어판이 있으면 null
const byPath = new Map(ix ? ix.urls.map((u) => [pathOf(u), ix.results[u]] as const) : []);
const indexCell = (key: string, post: boolean) => {
  const paths = post ? [`/${key}`, `/en/${key}`] : [key.length > 1 ? key.replace(/\/$/, '') : key];
  const rs = paths.filter((p) => byPath.has(p)).map((p) => byPath.get(p));
  if (!rs.length || !rs.every((r): r is Inspection => !!r)) return null;
  const ok = rs.map((r) => r.verdict === 'PASS');
  const label = ok.every(Boolean) ? '색인됨' : !ok.some(Boolean) ? '색인 안 됨' : ok[0] ? '한국어판만 색인' : '영어판만 색인';
  return { label, ok: ok.every(Boolean), why: rs.filter((r) => r.verdict !== 'PASS').map((r) => r.state).join(' · ') };
};
const pageRows = s ? s.pages.map((x) => ({ ...x, ix: indexCell(x.key, x.post) })) : [];
const series = s?.series();
const from = s?.incomplete && series ? series.days.indexOf(s.incomplete) : -1;
const chart = series && {
  type: 'line',
  opts: {
    labels: series.days.map(md),
    series: [{ name: '클릭', values: series.clicks }],
    annotations: from >= 0 ? [{ from, to: series.days.length - 1, label: '집계 중' }] : [],
    endLabel: true,
    height: 220,
    format: 'int',
  },
};
const prev = s?.sitePrev;
// 클릭 변화 — 앞 28일에 노출이 없던 글은 '새로'
const change = (id: string, clicks: number) => {
  const p = s?.postPrev(id);
  return !p ? '새로' : signed(clicks - p.clicks);
};
---
<Admin title="검색" active="search" sample={src.state === 'ok' && src.sample}>
  <div class="title-row">
    <div>
      <h1>검색</h1>
      <p class="sub">{s ? `Search Console · 최근 ${WINDOW}일 · ${md(s.end)}까지 (미국 태평양 시간)` : 'Search Console'}</p>
    </div>
    <a class="ghost" href="https://search.google.com/search-console" target="_blank" rel="noopener">Search Console 열기</a>
  </div>

  {idx.state !== 'off' && (
    <section class="card index-card" aria-labelledby="idx-title">
      <div class="card-head"><h2 id="idx-title">색인</h2><span class="meta">사이트맵 주소 · URL 검사</span></div>
      {idx.state === 'error' ? <Connect what="Search Console 색인" state="error" error={idx.error} /> : ix && g && (
        <>
          <dl class="figures">
            <div><dt>색인됨</dt><dd>{num(g.indexed.length)}<small>사이트맵 {num(ix.urls.length)}개 중</small></dd></div>
            <div><dt>색인 안 됨</dt><dd>{num(ix.urls.length - g.indexed.length - g.unchecked)}<small>까닭 {g.missing.length}가지</small></dd></div>
            <div><dt>확인 전</dt><dd>{num(g.unchecked)}<small>{ix.checking ? `지금 ${ix.checking}개 확인 중` : '없음'}</small></dd></div>
          </dl>
          <p class="card-note">
            주소마다 하루에 한 번, 화면을 열 때 뒤에서 다시 물어봐요{ix.checking ? '. 확인 중인 주소는 1분쯤 뒤 새로 고치면 채워져요' : ''}.
            주소를 누르면 Search Console 의 URL 검사가 열리고, 색인 생성 요청은 거기서 할 수 있어요.
          </p>
          {groups.map((x) => (
            <details class="idx">
              <summary><span>{x.label}</span>{x.fail && <span class="pill warn">오류</span>}<span class="n">{num(x.urls.length)}</span></summary>
              <div class="rows">
                {x.urls.map((u) => {
                  const r = ix.results[u], p = pageOf(u);
                  return (
                    <a class="row" href={r.link} target="_blank" rel="noopener">
                      <span><span class="t">{p.title}</span><span class="s">{p.path} · {r.crawled ? `크롤링 ${since(r.crawled)}` : '크롤링 전'}</span></span>
                    </a>
                  );
                })}
              </div>
            </details>
          ))}
          {ix.error && <p class="card-foot">지난 확인에서 묻지 못한 주소가 있어요: {ix.error}</p>}
        </>
      )}
    </section>
  )}

  {src.state !== 'ok' ? <section class="card"><Connect what="Search Console" state={src.state} error={'error' in src ? src.error : undefined} /></section> : s && prev && series && (
    <div class="overview">
      <div class="stack">
        <Kpis cells={[
          { label: `${WINDOW}일 클릭`, value: num(s.site.clicks), unit: '회', ...delta(s.site.clicks, prev.clicks, `이전 ${WINDOW}일`) },
          { label: `${WINDOW}일 노출`, value: num(s.site.impressions), unit: '회', ...delta(s.site.impressions, prev.impressions, `이전 ${WINDOW}일`) },
          { label: 'CTR', value: s.site.impressions ? pct(s.site.ctr) : null, caption: prev.impressions ? `이전 ${WINDOW}일 ${pct(prev.ctr)}` : `이전 ${WINDOW}일은 노출 없음` },
          { label: '평균 순위', value: s.site.impressions ? rank(s.site.position) : null, unit: '위', caption: prev.impressions ? `이전 ${WINDOW}일 ${rank(prev.position)}위` : `이전 ${WINDOW}일은 노출 없음` },
        ]} />

        <section class="card" aria-labelledby="clicks-title">
          <div class="card-head"><h2 id="clicks-title">날짜별 클릭</h2><span class="meta">최근 {DAYS}일</span></div>
          <div class="chart" style="--h:220px" data-chart={JSON.stringify(chart)} />
          {s.incomplete && <p class="card-foot">{md(s.incomplete)}부터는 아직 집계 중이라 숫자가 바뀔 수 있어요.</p>}
        </section>

        <section class="card" aria-labelledby="pages-title">
          <div class="card-head"><h2 id="pages-title">글별 검색</h2><span class="meta">최근 {WINDOW}일 · 한국어판과 영어판을 합쳐서</span></div>
          {s.pages.length ? (
            <div class="table-wrap">
              <table>
                <thead>
                  <tr><th>글</th><th class="num">클릭</th><th class="num">노출</th><th class="num">CTR</th><th class="num">평균 순위</th><th class="num">클릭 변화</th></tr>
                </thead>
                <tbody>
                  {pageRows.map((x) => (
                    <tr>
                      <td class="title">
                        {x.post ? (
                          <a href={`/posts/${x.key}`}><span>{titleOf(x.key)}</span><small>/{x.key}{x.ix && <> · <span class:list={['ix', { off: !x.ix.ok }]} title={x.ix.why || undefined}>{x.ix.label}</span></>}</small></a>
                        ) : (
                          <span class="plain">{PATHS[x.key] ?? x.key}<small>{x.key}{x.ix && <> · <span class:list={['ix', { off: !x.ix.ok }]} title={x.ix.why || undefined}>{x.ix.label}</span></>}</small></span>
                        )}
                      </td>
                      <td class="num">{num(x.clicks)}</td>
                      <td class="num">{num(x.impressions)}</td>
                      <td class="num">{pct(x.ctr)}</td>
                      <td class="num">{rank(x.position)}</td>
                      <td class="num">{x.post ? change(x.key, x.clicks) : <span class="dash">—</span>}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="empty">최근 {WINDOW}일 동안 검색에 노출된 주소가 없어요.</p>
          )}
        </section>
      </div>

      <aside class="rail" aria-label="고칠 글과 검색어">
        <section class="card" aria-labelledby="fix-title">
          <div class="card-head"><h2 id="fix-title">고칠 후보</h2><a class="meta" href="/posts?view=fix">글 화면에서 보기</a></div>
          <p class="card-note">노출 {FIX.minImpressions}회 이상인데 CTR 이 글 평균({pct(s.pageCtr)})의 절반이 안 되거나, 평균 {FIX.rankFrom}~{FIX.rankTo}위에 걸린 글. 제목·설명만 고쳐도 클릭이 늘 수 있어요.</p>
          {s.fix.length ? (
            <div class="rows wrap">
              <div class="rows-head" aria-hidden="true"><span>글</span><span class="r">노출</span><span class="r">순위</span></div>
              {s.fix.slice(0, 5).map((x) => (
                <a class="row" href={`/posts/${x.id}`}>
                  <span><span class="t">{titleOf(x.id)}</span><span class="s">{x.why.join(' · ')} · CTR {pct(x.ctr)}</span></span>
                  <span class="n">{num(x.impressions)}</span>
                  <span class="n">{rank(x.position)}</span>
                </a>
              ))}
            </div>
          ) : (
            <p class="empty">지금은 기준에 걸리는 글이 없어요.</p>
          )}
        </section>

        <section class="card" aria-labelledby="q-title">
          <div class="card-head"><h2 id="q-title">검색어</h2><span class="meta">클릭 순</span></div>
          {s.queries.length ? (
            <div class="rows tight">
              <div class="rows-head" aria-hidden="true"><span>검색어</span><span class="r">클릭</span><span class="r">노출</span></div>
              {s.queries.slice(0, 10).map((q) => (
                <div class="row"><span class="t">{q.query}</span><span class="n">{num(q.clicks)}</span><span class="n">{num(q.impressions)}</span></div>
              ))}
            </div>
          ) : (
            <p class="empty">아직 검색어가 없어요. 노출이 아주 적은 검색어는 Search Console 이 개인정보 보호로 빼고 보여 줘요.</p>
          )}
        </section>

        <section class="card" aria-labelledby="topic-title">
          <div class="card-head"><h2 id="topic-title">다음 글 후보</h2><span class="meta">{TOPIC.rankAbove}위 밖 검색어</span></div>
          <p class="card-note">노출은 되는데 순위가 {TOPIC.rankAbove}위 밖인 검색어예요. 이걸 다루는 글이 약하거나 없다는 뜻이에요.</p>
          {s.topics.length ? (
            <div class="rows tight">
              <div class="rows-head" aria-hidden="true"><span>검색어</span><span class="r">노출</span><span class="r">순위</span></div>
              {s.topics.slice(0, 8).map((q) => (
                <div class="row"><span class="t">{q.query}</span><span class="n">{num(q.impressions)}</span><span class="n">{rank(q.position)}</span></div>
              ))}
            </div>
          ) : (
            <p class="empty">노출 {TOPIC.minImpressions}회 이상인 {TOPIC.rankAbove}위 밖 검색어가 아직 없어요.</p>
          )}
        </section>
      </aside>
    </div>
  )}
</Admin>
