---
// 수익 — 먼저 답하는 질문: 이번 달은 얼마이고, 어떤 글과 나라에서 나오나.
// 승인 전에는 AdSense 계정·사이트 상태만 보여 준다
import posts from 'virtual:jd-posts';
import Admin from '../layouts/Admin.astro';
import Kpis from '../components/Kpis.astro';
import Connect from '../components/Connect.astro';
import CountryList from '../components/CountryList.astro';
import { loadRevenue, revenueStats, SITE_STATE, DAYS, WINDOW } from '../lib/revenue';
import { amount, md, money, num, unit } from '../lib/format';

const src = await loadRevenue();
const r = src.state === 'ok' ? src.data : null;
const s = r?.approved ? revenueStats(r) : null;

const titleOf = (id: string) => posts.find((p) => p.id === id)?.title ?? `/${id}`;
const cash = (n: number) => (s ? money(n, s.currency) : '');
const chart = s && {
  type: 'line',
  opts: {
    labels: s.series.days.map(md),
    series: [{ name: '예상 수익', values: s.series.values }],
    endLabel: true,
    height: 220,
    format: unit(s.currency) === s.currency ? 'dec2' : 'int',
  },
};
---
<Admin title="수익" active="revenue" sample={src.state === 'ok' && src.sample}>
  <div class="title-row">
    <div>
      <h1>수익</h1>
      <p class="sub">{s ? `AdSense 예상 수익 · ${md(s.series.days.at(-1)!)}까지` : r ? 'AdSense · 승인 전' : 'AdSense'}</p>
    </div>
    <a class="ghost" href="https://adsense.google.com/" target="_blank" rel="noopener">AdSense 열기</a>
  </div>

  {src.state !== 'ok' ? <section class="card"><Connect what="AdSense" state={src.state} error={'error' in src ? src.error : undefined} /></section> : r && !r.approved ? (
    <div class="two">
      <section class="card" aria-labelledby="state-title">
        <div class="card-head"><h2 id="state-title">승인 상태</h2><span class="pill">승인 전</span></div>
        <ul class="steps">
          <li><span>계정<small>{r.account ? r.account.replace('accounts/', '') : '이 Google 계정에는 AdSense 계정이 없어요'}</small></span></li>
          <li>
            <span>사이트<small>{r.site ? r.site.domain : '블로그 주소가 AdSense 사이트 목록에 없어요'}</small></span>
            {r.site && <span class="pill">{SITE_STATE[r.site.state] ?? r.site.state}</span>}
          </li>
        </ul>
        {r.site?.state === 'NEEDS_ATTENTION' && <p class="card-foot">AdSense 의 사이트 화면에서 고칠 것을 확인하세요.</p>}
      </section>
      <section class="card" aria-labelledby="later-title">
        <div class="card-head"><h2 id="later-title">승인되면 보일 것</h2></div>
        <ul class="steps">
          <li><span>날짜별 예상 수익, 이번 달과 지난달 같은 기간</span></li>
          <li><span>글별 수익과 페이지 RPM</span></li>
          <li><span>나라별 수익</span></li>
          <li><span>개요의 넷째 숫자가 '7일 검색 클릭'에서 '이번 달 수익'으로</span></li>
        </ul>
      </section>
    </div>
  ) : s && (
    <div class="overview">
      <div class="stack">
        <Kpis cells={[
          { label: '오늘', value: amount(s.today.earnings, s.currency), unit: unit(s.currency), caption: '집계 중' },
          { label: '어제', value: amount(s.yesterday.earnings, s.currency), unit: unit(s.currency), caption: `페이지뷰 ${num(s.yesterday.pageViews)}회` },
          { label: '이번 달', value: amount(s.month.earnings, s.currency), unit: unit(s.currency), caption: `지난달 같은 기간 ${cash(s.lastMonth.earnings)}` },
          { label: `${WINDOW}일 페이지 RPM`, value: amount(s.window.rpm, s.currency), unit: unit(s.currency), caption: `페이지뷰 1,000회당 · ${WINDOW}일 ${cash(s.window.earnings)}` },
        ]} />

        <section class="card" aria-labelledby="daily-title">
          <div class="card-head"><h2 id="daily-title">날짜별 예상 수익</h2><span class="meta">최근 {DAYS}일</span></div>
          <div class="chart" style="--h:220px" data-chart={JSON.stringify(chart)} />
          <p class="card-foot">어제까지는 거의 확정이고, 오늘 숫자는 예상이라 바뀔 수 있어요.</p>
        </section>

        <section class="card" aria-labelledby="posts-title">
          <div class="card-head"><h2 id="posts-title">글별 수익</h2><span class="meta">최근 {WINDOW}일 · 한국어판과 영어판을 합쳐서</span></div>
          {s.posts.length ? (
            <div class="table-wrap">
              <table>
                <thead><tr><th>글</th><th class="num">예상 수익</th><th class="num">페이지뷰</th><th class="num">페이지 RPM</th></tr></thead>
                <tbody>
                  {s.posts.map((x) => (
                    <tr>
                      <td class="title"><a href={`/posts/${x.id}`}><span>{titleOf(x.id)}</span><small>/{x.id}</small></a></td>
                      <td class="num">{cash(x.earnings)}</td>
                      <td class="num">{num(x.pageViews)}</td>
                      <td class="num">{cash(x.rpm)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="empty">최근 {WINDOW}일 동안 글 주소에서 난 수익이 없어요.</p>
          )}
        </section>
      </div>

      <aside class="rail" aria-label="나라별 수익">
        <section class="card" aria-labelledby="cc-title">
          <div class="card-head"><h2 id="cc-title">나라</h2><span class="meta">최근 {WINDOW}일 예상 수익</span></div>
          <CountryList
            items={s.countries.map((c) => ({ cc: c.cc, n: c.earnings }))}
            total={s.countries.reduce((a, c) => a + c.earnings, 0)}
            limit={8}
            show={cash}
            empty="아직 나라별 수익이 없어요."
          />
        </section>
      </aside>
    </div>
  )}
</Admin>
