---
// 글 상세 — 먼저 답하는 질문: 이 글은 누가, 무엇으로 찾아와 읽나
import posts from 'virtual:jd-posts';
import Admin from '../../layouts/Admin.astro';
import Kpis from '../../components/Kpis.astro';
import CountryList from '../../components/CountryList.astro';
import LoadError from '../../components/LoadError.astro';
import Connect from '../../components/Connect.astro';
import CommentList from '../../components/CommentList.astro';
import { loadReport } from '../../lib/report';
import { loadSearch, searchStats, WINDOW } from '../../lib/search';
import { loadRevenue, revenueStats, WINDOW as REVENUE_WINDOW } from '../../lib/revenue';
import { loadComments, commentStats } from '../../lib/comments';
import { derive, LAUNCH_DAYS } from '../../lib/stats';
import { BLOG, delta, md, money, num, pct, rank, thumb, ymd } from '../../lib/format';

const post = posts.find((p) => p.id === Astro.params.id);
if (!post) return new Response('없는 글이에요.', { status: 404, headers: { 'content-type': 'text/plain; charset=utf-8' } });

const [loaded, sc, ads, cm] = await Promise.all([loadReport(), loadSearch(), loadRevenue(), loadComments()]);
const d = 'report' in loaded ? derive(loaded.report) : null;
const row = d?.rows.find((x) => x.post.id === post.id);
const countries = d ? d.postCountries(post.id) : [];
const SPAN = 60; // 날짜별 조회를 보는 날 수
const series = d?.postSeries(post, SPAN);
const recorded = series?.values.some((v) => v != null);
const chart = series && {
  type: 'line',
  opts: {
    labels: series.days.map(md),
    series: [{ name: '하루 조회', values: series.values }],
    annotations: d?.postStart && series.days[0] < d.postStart ? [{ from: 0, to: Math.max(0, series.days.indexOf(d.postStart) - 1), label: '기록 전' }] : [],
    endLabel: true,
    height: 220,
    format: 'int',
  },
};
const p7 = row && delta(row.d7, row.prev7, '이전 7일');
const ss = sc.state === 'ok' ? searchStats(sc.data) : null;
const q = ss?.post(post.id);
const qPrev = ss?.postPrev(post.id);
const queries = ss?.postQueries(post.id) ?? [];
const rs = ads.state === 'ok' && ads.data.approved ? revenueStats(ads.data) : null;
const earn = rs?.post(post.id);
const cs = cm.state === 'ok' ? commentStats(cm.data) : null;
const comments = cs?.post(post.id) ?? [];
const later = [
  ...(rs ? [] : [{ name: '예상 수익 · 페이지 RPM', step: ads.state === 'ok' ? '승인 전' : ads.state === 'off' ? '열쇠 없음' : '오류' }]),
  { name: '유입 경로 · 기기 · 속도(LCP·INP·CLS)', step: '3단계' },
];
const sample = [sc, ads, cm].some((x) => x.state === 'ok' && x.sample) || ('sample' in loaded && loaded.sample);
---
<Admin title={post.title} active="posts" sample={sample} crumbs={[{ label: '글', href: '/posts' }, { label: `/${post.id}` }]}>
  <div class="detail-head">
    <img class="thumb" src={thumb(post.id)} alt="" width="200" height="105" />
    <div>
      <h1>{post.title}</h1>
      <p>/{post.id} · {post.category} · {post.subcategory} · {ymd(row?.pub ?? post.pubDate.slice(0, 10))} 올림{row && ` · 올린 지 ${row.age}일`}</p>
      {post.titleEn && <p>{post.titleEn}</p>}
      <div class="links">
        <a class="ghost" href={`${BLOG}/${post.id}`} target="_blank" rel="noopener">블로그에서 보기</a>
        {post.titleEn && <a class="ghost" href={`${BLOG}/en/${post.id}`} target="_blank" rel="noopener">영어판</a>}
        <a class="ghost" href={`https://github.com/jojaden/jaden-log/blob/main/src/content/posts/${post.id}.mdx`} target="_blank" rel="noopener">원문 파일</a>
        {row && row.age <= LAUNCH_DAYS && <a class="ghost" href={`/?post=${post.id}`}>반응 곡선</a>}
      </div>
    </div>
  </div>

  {'error' in loaded ? <LoadError error={loaded.error} /> : d && row && (
    <div class="overview">
      <div class="stack">
        <Kpis cells={[
          { label: '지금까지 조회', value: num(row.all), unit: '회' },
          { label: '30일 조회', value: num(row.d30), unit: '회', caption: d.postStart && d.postStart > row.pub ? `${md(d.postStart)}부터 기록` : undefined },
          { label: '7일 조회', value: num(row.d7), unit: '회', ...p7 },
          { label: '읽은 나라', value: num(countries.length), unit: '곳' },
        ]} />
        <section class="card">
          <div class="card-head"><h2>날짜별 조회</h2><span class="meta">{series && series.days.length < SPAN ? '올린 날부터' : `최근 ${SPAN}일`}</span></div>
          {recorded ? <div class="chart" style="--h:220px" data-chart={JSON.stringify(chart)} /> : <p class="empty">이 글의 날짜별 조회 기록이 아직 없어요.</p>}
        </section>
        <section class="card" aria-labelledby="search-title">
          <div class="card-head"><h2 id="search-title">검색</h2><span class="meta">Search Console 최근 {WINDOW}일 · 한국어판과 영어판을 합쳐서</span></div>
          {sc.state !== 'ok' ? <Connect what="Search Console" state={sc.state} error={'error' in sc ? sc.error : undefined} /> : !q ? (
            <p class="empty">최근 {WINDOW}일 동안 이 글이 검색에 노출되지 않았어요.</p>
          ) : (
            <>
              <dl class="figures">
                <div><dt>클릭</dt><dd>{num(q.clicks)}<small>{qPrev ? `이전 ${WINDOW}일 ${num(qPrev.clicks)}` : `이전 ${WINDOW}일 노출 없음`}</small></dd></div>
                <div><dt>노출</dt><dd>{num(q.impressions)}<small>{qPrev && `이전 ${WINDOW}일 ${num(qPrev.impressions)}`}</small></dd></div>
                <div><dt>CTR</dt><dd>{pct(q.ctr)}<small>{qPrev && `이전 ${WINDOW}일 ${pct(qPrev.ctr)}`}</small></dd></div>
                <div><dt>평균 순위</dt><dd>{rank(q.position)}<small>{qPrev && `이전 ${WINDOW}일 ${rank(qPrev.position)}`}</small></dd></div>
              </dl>
              {queries.length ? (
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>이 글로 들어온 검색어</th><th class="num">클릭</th><th class="num">노출</th><th class="num">CTR</th><th class="num">평균 순위</th></tr></thead>
                    <tbody>
                      {queries.slice(0, 15).map((x) => (
                        <tr><td class="query">{x.query}</td><td class="num">{num(x.clicks)}</td><td class="num">{num(x.impressions)}</td><td class="num">{pct(x.ctr)}</td><td class="num">{rank(x.position)}</td></tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : (
                <p class="empty">노출이 적은 검색어는 Search Console 이 개인정보 보호로 빼고 보여 줘서, 이 글의 검색어가 아직 없어요.</p>
              )}
            </>
          )}
        </section>
        <section class="card" aria-labelledby="cm-title">
          <div class="card-head"><h2 id="cm-title">댓글</h2><span class="meta">{cs ? `${comments.length}개${comments.some((t) => t.needsReply) ? ` · 답할 것 ${comments.filter((t) => t.needsReply).length}개` : ''}` : 'GitHub Discussions'}</span></div>
          {cm.state !== 'ok' ? <Connect what="GitHub Discussions" state={cm.state} error={'error' in cm ? cm.error : undefined} /> : comments.length ? (
            <CommentList items={comments} owner={cs!.owner} />
          ) : (
            <p class="empty">이 글에는 아직 댓글이 없어요.</p>
          )}
        </section>
        <section class="card">
          <div class="card-head"><h2>이 글에 더 붙을 데이터</h2></div>
          <ul class="steps">
            {later.map((s) => <li><span>{s.name}</span><span class="pill">{s.step}</span></li>)}
          </ul>
        </section>
      </div>
      <aside class="rail" aria-label="이 글을 읽은 나라와 수익">
        <section class="card" aria-labelledby="cc-title">
          <div class="card-head"><h2 id="cc-title">나라</h2><span class="meta">지금까지 조회</span></div>
          <CountryList items={countries} total={countries.reduce((s, c) => s + c.n, 0)} limit={8} />
        </section>
        {rs && (
          <section class="card" aria-labelledby="earn-title">
            <div class="card-head"><h2 id="earn-title">수익</h2><span class="meta">AdSense 최근 {REVENUE_WINDOW}일</span></div>
            {earn ? (
              <ul class="steps">
                <li><span>예상 수익</span><span class="num">{money(earn.earnings, rs.currency)}</span></li>
                <li><span>페이지뷰</span><span class="num">{num(earn.pageViews)}</span></li>
                <li><span>페이지 RPM</span><span class="num">{money(earn.rpm, rs.currency)}</span></li>
              </ul>
            ) : (
              <p class="empty">최근 {REVENUE_WINDOW}일 동안 이 글에서 난 수익이 없어요.</p>
            )}
          </section>
        )}
      </aside>
    </div>
  )}
</Admin>
