{
  // 관리자 화면 — Worker 전체를 Cloudflare Access 로 잠근다 (Workers & Pages → jaden-log-admin → Access).
  // 이 파일이 없으면 wrangler 가 상위 폴더의 블로그 설정(jaden-log)을 잡으니 지우지 않는다
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaden-log-admin",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  // 버전 미리보기 주소는 쓰지 않는다 — 열 수 있는 주소를 하나로
  "preview_urls": false,
  // 블로그 Worker(jaden-log)의 방문 수 Durable Object — 읽기 전용 report() 만 부른다.
  // 로컬에서는 블로그를 따로 띄워야 이어진다 (저장소 루트에서 npx wrangler dev)
  "durable_objects": {
    "bindings": [{ "name": "VIEWS", "class_name": "ViewCounter", "script_name": "jaden-log" }]
  },
  // 같은 블로그 Worker — 색인 화면이 사이트맵을 읽는다. 같은 계정의 workers.dev 주소는 fetch 로 부를 수 없어 바인딩으로
  "services": [{ "binding": "BLOG", "service": "jaden-log" }],
  // Search Console·AdSense·댓글 응답을 잠깐 담아 두는 KV — 첫 배포 때 wrangler 가 만든 jaden-log-admin-cache
  "kv_namespaces": [{ "binding": "CACHE", "id": "63be17e31fb64196b9cd59f0294984f5" }],
  // 미들웨어가 Access JWT 를 검증할 때 쓰는 발급자(팀 도메인)와 받는 쪽(이 Worker 의 Access 앱 AUD 태그).
  // 둘 다 Access 로그인 화면 주소에 드러나는 값이라 비밀이 아니다. Access 앱을 다시 만들면 AUD 가 바뀌니 함께 고친다
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://jaden-log.cloudflareaccess.com",
    "ACCESS_AUD": "66561e75e35c895ae14baee97684aadeb16d75d83333cfe1013a818be3409d06"
  },
  // 로컬 개발에서만 Access 로그인한 상태를 흉내 낸다. 이 블록을 지우면 403 화면을 볼 수 있다
  "access": {
    "dev": { "aud": "jaden-log-admin-dev", "identity": { "email": "admin@localhost" } }
  }
}
