---
import '../styles/global.css';
import GlassNav from '../components/GlassNav.astro';
import Drawer from '../components/Drawer.astro';
import Footer from '../components/Footer.astro';
import { SITE, siteText } from '../lib/site';
import { langOf, localize, ui, type Lang } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  published?: Date;
  // 언어별 같은 페이지 주소 (hreflang · 언어 전환). 없으면 같은 경로의 다른 언어판이 있다고 본다
  alt?: Partial<Record<Lang, string>>;
  switchTo?: string; // 언어 전환이 갈 곳 — 다른 언어판에 같은 페이지가 없을 때 (기본: alt 의 다른 언어, 없으면 그 언어 홈)
}
const lang = langOf(Astro.url);
const t = ui(lang);
const { title, description = siteText(lang).description, image, type = 'website', noindex = false, published } = Astro.props;
const base = lang === 'en' ? Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/' : Astro.url.pathname;
const alt = Astro.props.alt ?? { ko: localize(base, 'ko'), en: localize(base, 'en') };
const other: Lang = lang === 'en' ? 'ko' : 'en';
const fullTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {!noindex && Object.entries(alt).map(([l, href]) => <link rel="alternate" hreflang={l} href={new URL(href, Astro.site)} />)}
    {!noindex && alt.ko && <link rel="alternate" hreflang="x-default" href={new URL(alt.ko, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={localize('/rss.xml', lang)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    {/* 로고 글꼴 — text= 로 'Jaden.log' 글자만 받아 몇 KB 로 끝낸다 */}
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600&text=Jaden.log&display=swap" />
    <slot name="head" />
    {/* .jd-rise 를 JS 가 맡는다는 표시 — 첫 화면이 그려지기 전에 달아야 깜빡이지 않고, JS 가 꺼져 있으면 그냥 보인다 */}
    <script is:inline>document.documentElement.classList.add('jd-rise-js');</script>
  </head>
  <body>
    <a class="jd-skip jd-sr" href="#main">{t.skip}</a>
    <GlassNav switchTo={Astro.props.switchTo ?? alt[other] ?? localize('/', other)} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Drawer />
    <script>
      // .jd-rise — 화면에 들어오면 떠오른다 (스타일은 global.css 의 .jd-rise-js). 본문 형광펜(<mark>)과 막대 그래프(.jd-bars)도 같은 때에 그어진다
      // 화면 아래로 벗어나면 .is-in 을 떼어 다시 내려올 때 또 떠오르고, 위로 지나간 것은 보이는 채로 둔다
      // 들어올 때는 화면 아래 8% 를 지나야, 나갈 때는 화면 밖으로 완전히 나가야 바꾼다 (경계에서 깜빡이지 않게).
      // 스크롤이 크게 건너뛰면 화면을 거치지 않은 요소는 알림이 없으므로, 하나가 들어오면 문서상 그 앞의 것도 함께 보인다
      const items = [...document.querySelectorAll('.jd-rise, .prose mark, .jd-bars')];
      const enter = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting && e.boundingClientRect.top >= 0) continue;
          for (const el of items) { el.classList.add('is-in'); if (el === e.target) break; }
        }
      }, { rootMargin: '0px 0px -8% 0px' });
      const leave = new IntersectionObserver((entries) => {
        for (const e of entries) if (!e.isIntersecting && e.boundingClientRect.top > 0) e.target.classList.remove('is-in');
      });
      items.forEach((el) => { enter.observe(el); leave.observe(el); });

      // .jd-pan — 한 줄로 잘린 글이 넘친 길이를 재 둔다. 마우스를 올리면 그만큼 옆으로 흐른다 (스타일은 global.css).
      // 크기가 바뀔 때마다(페이지 넘김으로 처음 보일 때 포함) 다시 잰다
      const pan = new ResizeObserver((entries) => {
        for (const { target } of entries) {
          const el = target as HTMLElement;
          const over = el.scrollWidth - el.clientWidth;
          el.classList.toggle('is-over', over > 1);
          el.style.setProperty('--pan', `${-over}px`);
          el.style.setProperty('--pan-w', `${el.scrollWidth}px`); // 글 전체 폭 — 마우스를 올리면 이만큼 넓어지는 카드가 쓴다
          el.style.setProperty('--pan-t', `${Math.max(0.15, over / 70)}s`); // 어디서든 초당 70px — 조금만 넘쳐도 느려지지 않게 최소 시간은 짧게
        }
      });
      document.querySelectorAll('.jd-pan').forEach((el) => pan.observe(el));
    </script>
  </body>
</html>
