---
import ListPage from '../../../../components/ListPage.astro';
import SubNav from '../../../../components/SubNav.astro';
import { getPosts, countBy } from '../../../../lib/posts';
import { CATEGORIES, catHref, subLabel } from '../../../../lib/site';
import { LANGS, langOf, langParam, localize, ui } from '../../../../lib/i18n';
export function getStaticPaths() {
  return LANGS.flatMap((l) => CATEGORIES.flatMap((cat) => cat.subs.map((sub) => ({ params: { lang: langParam(l), cat: cat.slug, sub: cat.subSlugs[sub] }, props: { cat, sub } }))));
}
const { cat, sub } = Astro.props;
const lang = langOf(Astro.url);
const t = ui(lang);
const all = await getPosts(lang);
const posts = all.filter((p) => p.data.category === cat.name && p.data.subcategory === sub);
const counts = countBy(all).sub;
---
<ListPage title={subLabel(cat.name, sub, lang)} acc={cat.acc} eyebrow={cat.name} cardEyebrow="none" posts={posts} crumbs={[{ href: localize('/category', lang), label: t.allPosts }, { href: catHref(cat.name, undefined, lang), label: cat.name }]}>
  <SubNav slot="after-title" cat={cat} current={sub} counts={counts} />
</ListPage>
