---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Topics from '../../components/Topics.astro';
import Popular from '../../components/Popular.astro';
import PagedGrid from '../../components/PagedGrid.astro';
import { getPosts } from '../../lib/posts';
import { LANGS, langOf, langParam, localize, ui } from '../../lib/i18n';
export const getStaticPaths = () => LANGS.map((l) => ({ params: { lang: langParam(l) } }));
const lang = langOf(Astro.url);
const t = ui(lang);
const posts = await getPosts(lang);
const rest = posts.slice(1);
---
<Base>
  {/* 바탕이 번갈아 깔린다 — 첫 화면(검정·흰) → 주제와 많이 읽은 글(띠) → 최근 글(검정·흰) → 푸터(띠) */}
  <div class="jd-wrap jd-glow">
    <Hero posts={posts.slice(0, 3)} />
  </div>
  <div class="jd-band jd-home-band">
    <div class="jd-wrap">
      <Topics />
      <Popular />
    </div>
  </div>
  <div class="jd-wrap">
    <section class="jd-home-latest" aria-labelledby="jd-latest-title">
      <div class="jd-sec-head jd-rise" id="jd-latest">
        <h2 class="jd-sec-title" id="jd-latest-title">{t.recent}</h2>
        <a class="jd-more" href={localize('/category', lang)}>{t.allPostsLink}</a>
      </div>
      <PagedGrid posts={rest} anchor="jd-latest" perPage={6} shelf />
    </section>
  </div>
</Base>
<style>
  .jd-home-band { padding: 128px 0; }
  .jd-home-latest { padding-top: 128px; }
  #jd-latest { scroll-margin-top: 96px; margin-bottom: 16px; align-items: baseline; }
  @media (max-width: 760px) {
    .jd-home-band { padding: 84px 0; }
    .jd-home-latest { padding-top: 84px; }
  }
</style>
