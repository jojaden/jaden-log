---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Series from '../../components/Series.astro';
import { render } from 'astro:content';
import { mdxComponents } from '../../components/mdx';
import { getBuildablePosts, getPosts, postHref, postLang, formatDate, readMinutes, buildToc, nbHyphen, splitTitle } from '../../lib/posts';
import { catHref, catOf, tagHref, subLabel, SITE, GISCUS } from '../../lib/site';
import { LANGS, langParam, ui } from '../../lib/i18n';
import { seriesOf } from '../../lib/series';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const [ko, en] = await Promise.all(LANGS.map((l) => getBuildablePosts(l)));
  const enIds = new Set(en.map((p) => p.id));
  const koIds = new Set(ko.map((p) => p.id));
  // alt: 같은 글의 언어별 주소 — 번역이 없는 쪽은 빼서 hreflang 과 언어 전환이 없는 페이지를 가리키지 않게
  const alt = (id: string) => ({ ...(koIds.has(id) && { ko: `/${id}` }), ...(enIds.has(id) && { en: `/en/${id}` }) });
  return [...ko, ...en].map((post) => ({ params: { lang: langParam(postLang(post)), slug: post.id }, props: { post, alt: alt(post.id) } }));
}
const { post, alt } = Astro.props;
const lang = postLang(post);
const t = ui(lang);
const { title, description, pubDate, updatedDate, category, subcategory, tags, stub, tistoryId, hidden } = post.data;
const subName = subLabel(category, subcategory, lang);
const { Content } = await render(post);
const toc = buildToc(post.body);

const list = await getPosts(lang);
const idx = list.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? list[idx - 1] : undefined;
const older = idx >= 0 && idx < list.length - 1 ? list[idx + 1] : undefined;
const sameSub = list.filter((p) => p.id !== post.id && p.data.category === category && p.data.subcategory === subcategory).slice(0, 5);
const related = list
  .filter((p) => p.id !== post.id && !sameSub.includes(p))
  .map((p) => ({ p, s: (p.data.category === category ? 2 : 0) + p.data.tags.filter((t) => tags.includes(t)).length }))
  .filter((x) => x.s > 0)
  .sort((a, b) => b.s - a.s || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 3)
  .map((x) => x.p);
// 시리즈 — 이 언어 목록에 있는 편만 (영어판이 없는 편은 빠진다). 두 편 이상일 때만 보인다
const series = seriesOf(post.id);
const seriesItems = (series?.parts ?? []).flatMap((part) => {
  const p = list.find((x) => x.id === part.id);
  return p ? [{ href: postHref(p), label: part.label[lang], current: p.id === post.id }] : [];
});
const minutes = readMinutes(post.body, lang);
const { main, sub } = splitTitle(title);
---
<Base title={title} description={description} type="article" published={pubDate} noindex={hidden || stub} alt={alt}>
  <div class="jd-progress" aria-hidden="true"></div>
  <article class="jd-post" data-post={post.id} data-pagefind-body>
    <header class="jd-post-head jd-wrap">
      <p class="jd-post-cat"><a href={catHref(category, undefined, lang)}>{category}</a><span>·</span><a href={catHref(category, subcategory, lang)}>{subName}</a></p>
      <h1 class="jd-post-title jd-grad" data-pagefind-meta="title">{nbHyphen(main)}{sub && <><span class="jd-sr"> — </span><span class="jd-post-sub">{sub}</span></>}</h1>
      <p class="jd-post-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
        {updatedDate && <span>{t.updated} <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, lang)}</time></span>}
        <span>{t.minutes(minutes)}</span>
      </p>
    </header>

    <div class="jd-post-grid jd-wrap">
      <div class="jd-post-main">
        {toc.length > 5 && (
          <details class="jd-toc-inline" open data-pagefind-ignore>
            <summary>{t.toc}</summary>
            <Toc items={toc} />
          </details>
        )}
        {stub && (
          <aside class="jd-stub">
            {t.stub} <a href={`${SITE.tistory}/${tistoryId}`} rel="noopener">{t.stubLink}</a>
          </aside>
        )}
        <div class="prose">
          <Content components={mdxComponents} />
        </div>

        {tags.length > 0 && (
          <ul class="jd-post-tags" aria-label={t.tags}>
            {tags.map((tag) => <li><a href={tagHref(tag, lang)}>#{tag}</a></li>)}
          </ul>
        )}
      </div>
      {toc.length > 0 && (
        <aside class="jd-post-aside" data-pagefind-ignore>
          <div class="jd-post-aside-in"><Toc items={toc} /></div>
        </aside>
      )}
    </div>

    <footer class="jd-post-foot jd-wrap" data-pagefind-ignore>
      {series && seriesItems.length > 1 && <Series title={series.title[lang]} items={seriesItems} />}

      {(newer || older) && (
        <nav class="jd-prevnext" aria-label={t.prevNext}>
          {[older && { p: older, dir: t.prev, next: false }, newer && { p: newer, dir: t.next, next: true }].map((x) => x && (
            <a class:list={['jd-pn', 'jd-pan-host', x.next && 'is-next']} href={postHref(x.p)}>
              <span class="jd-pn-ic" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={x.next ? 'M6 3l5 5-5 5' : 'M10 3L5 8l5 5'} /></svg></span>
              <span class="jd-pn-text"><span class="jd-pn-dir">{x.dir}</span><strong class="jd-pan"><span class="jd-pan-in">{x.p.data.title}</span></strong></span>
            </a>
          ))}
        </nav>
      )}

      {sameSub.length > 0 && (
        <section>
          <h2 class="jd-foot-title">{t.sameSub(subName)} <a class="jd-more" href={catHref(category, subcategory, lang)}>{t.seeAll}</a></h2>
          <ul class="jd-samesub">
            {sameSub.map((p) => <li><a class="jd-pan-host" href={postHref(p)}><strong class="jd-pan"><span class="jd-pan-in">{p.data.title}</span></strong><time>{formatDate(p.data.pubDate, lang)}</time></a></li>)}
          </ul>
        </section>
      )}

      {related.length > 0 && (
        <section>
          <h2 class="jd-foot-title is-plain">{t.related}</h2>
          <ul class="jd-rel">
            {related.map((p) => (
              <li>
                <a class="jd-pan-host" href={postHref(p)} style={`--jd-acc:${catOf(p.data.category)?.acc ?? 'var(--jd-text-3)'}`}>
                  <span class="jd-rel-cat">{p.data.category} · {subLabel(p.data.category, p.data.subcategory, lang)}</span>
                  <strong class="jd-pan"><span class="jd-pan-in">{p.data.title}</span></strong>
                  <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate, lang)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* 댓글은 한국어판·영어판이 같은 스레드를 쓴다 — 주소가 아니라 글 번호로 묶는다 */}
      <section id="comments" aria-label={t.comments}>
        <h2 class="jd-foot-title">{t.comments}</h2>
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={GISCUS.repo}
          data-repo-id={GISCUS.repoId}
          data-category={GISCUS.category}
          data-category-id={GISCUS.categoryId}
          data-mapping="specific"
          data-term={`post/${post.id}`}
          data-strict="1"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="transparent_dark"
          data-lang={lang}
          data-loading="lazy"
          crossorigin="anonymous"
          async
        ></script>
      </section>
    </footer>
  </article>
</Base>

<script>
  // 목차: 지금 읽는 섹션 강조
  const links = new Map<string, HTMLAnchorElement[]>();
  document.querySelectorAll<HTMLAnchorElement>('.jd-toc a[data-toc]').forEach((a) => {
    const id = a.dataset.toc!;
    links.set(id, [...(links.get(id) ?? []), a]);
  });
  const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    let active = '';
    const set = (id: string) => {
      if (id === active) return;
      links.get(active)?.forEach((a) => a.classList.remove('is-active'));
      links.get(id)?.forEach((a) => a.classList.add('is-active'));
      active = id;
    };
    const onScroll = () => {
      const y = 120;
      let cur = targets[0].id;
      for (const t of targets) { if (t.getBoundingClientRect().top - y <= 0) cur = t.id; else break; }
      set(cur);
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // 읽기 진행 막대 대체 동작 — scroll() 타임라인이 없는 브라우저(Firefox 등)만
  const bar = document.querySelector<HTMLElement>('.jd-progress');
  if (bar && !CSS.supports('animation-timeline: scroll()')) {
    let queued = false;
    const update = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  /* 읽은 만큼 차는 막대 — 스크롤 타임라인 지원 브라우저는 CSS 만, 없는 브라우저(Firefox 등)는 위 스크립트가 scaleX 를 넣는다 */
  .jd-progress {
    position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 100;
    background: linear-gradient(90deg, #2997FF, #BF5AF2); transform-origin: 0 50%; transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    .jd-progress {
      /* 단축 속성은 CSS 압축 때 animation-timeline 과 합쳐져 버려지므로 개별 속성으로 쓴다 */
      animation-name: jdProg; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root);
    }
    @keyframes jdProg { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  }

  .jd-post-head { max-width: calc(var(--jd-read) + var(--jd-gutter) * 2); padding-top: 88px; padding-bottom: 48px; }
  .jd-post-cat { display: flex; gap: 8px; margin: 0 0 14px; font-size: 17px; font-weight: 600; }
  .jd-post-cat span { color: var(--jd-text-3); }
  .jd-post-title { margin: 0 0 24px; font-size: clamp(34px, 4.2vw, 56px); font-weight: 700; letter-spacing: -.03em; line-height: 1.1; padding-bottom: .06em; }
  .jd-post-sub { display: block; margin-top: 14px; font-size: clamp(20px, 2vw, 26px); line-height: 1.35; letter-spacing: -.02em; font-weight: 600; background: none; -webkit-text-fill-color: var(--jd-text-2); color: var(--jd-text-2); }
  .jd-post-meta { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 0; font-size: 14px; color: var(--jd-text-3); }

  .jd-post-grid { display: grid; grid-template-columns: minmax(0, var(--jd-read)); justify-content: center; gap: 64px; }
  .jd-post-aside { display: none; }

  .jd-toc-inline { margin: 0 0 48px; padding: 18px 0; border-top: 1px solid var(--jd-line); border-bottom: 1px solid var(--jd-line); }
  .jd-toc-inline summary { cursor: pointer; font-size: 13px; font-weight: 700; letter-spacing: .04em; color: var(--jd-link); list-style: none; }
  .jd-toc-inline summary::-webkit-details-marker { display: none; }
  .jd-toc-inline[open] summary { margin-bottom: 4px; }
  .jd-toc-inline :global(.jd-toc-title) { display: none; }

  /* 넓은 화면: 본문은 가운데, 목차는 오른쪽에 따라온다 — 본문 900px 양옆에 목차 칸(190px 이상)이 남는 폭부터 */
  @media (min-width: 1440px) {
    .jd-post-grid { grid-template-columns: 1fr minmax(0, var(--jd-read)) 1fr; gap: 56px; max-width: none; }
    .jd-post-main { grid-column: 2; }
    .jd-post-aside { display: block; grid-column: 3; max-width: 240px; }
    .jd-post-aside-in { position: sticky; top: 96px; max-height: calc(100dvh - 120px); overflow-y: auto; }
    .jd-toc-inline { display: none; }
  }

  .jd-stub { margin: 0 0 32px; padding: 16px 20px; border-radius: 14px; background: rgba(255, 159, 10, .1); border: 1px solid rgba(255, 159, 10, .3); font-size: 15px; color: #FFD08A; }

  .jd-post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 48px 0 0; padding: 0; list-style: none; }
  .jd-post-tags a { display: inline-flex; padding: 6px 14px; border-radius: 980px; background: var(--jd-glass); border: 1px solid var(--jd-glass-line); font-size: 14px; color: var(--jd-text-2); }
  .jd-post-tags a:hover { color: var(--jd-text); text-decoration: none; }

  /* 이전·다음 글, 같은 주제 글, 관련 글, 댓글 — 본문과 같은 열에 맞춘다 */
  /* 글 아래 — 상자 없이 얇은 선과 여백으로만 나눈다. 섹션 제목은 모두 .jd-foot-title 하나 */
  .jd-post-foot { max-width: calc(var(--jd-read) + var(--jd-gutter) * 2); margin-top: 80px; display: flex; flex-direction: column; gap: 64px; }
  .jd-post-foot a:hover { text-decoration: none; }

  /* 이전·다음 글 — 화살표 아이콘이 있는 카드 두 장. 다음 글은 오른쪽 칸, 화살표도 오른쪽 */
  .jd-prevnext { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .jd-pn { display: flex; align-items: center; gap: 14px; padding: 16px 18px; border-radius: 16px; background: rgba(255, 255, 255, .03); border: 1px solid var(--jd-line); transition: background .2s, border-color .2s; }
  .jd-pn:hover { background: var(--jd-glass); border-color: var(--jd-glass-line); }
  .jd-pn.is-next { grid-column: 2; flex-direction: row-reverse; text-align: right; }
  .jd-pn-ic { flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--jd-glass-2); color: var(--jd-text-2); transition: background .2s, color .2s; }
  .jd-pn:hover .jd-pn-ic { background: var(--jd-link); color: #fff; }
  .jd-pn-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .jd-pn-dir { font-size: 12.5px; color: var(--jd-text-3); }
  .jd-pn strong { font-size: 15.5px; line-height: 1.45; font-weight: 600; color: var(--jd-text); }

  .jd-foot-title { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin: 0; padding-bottom: 14px; border-bottom: 1px solid var(--jd-line); font-size: 19px; font-weight: 700; letter-spacing: -.02em; color: var(--jd-text); }
  .jd-foot-title.is-plain { padding-bottom: 0; border-bottom: 0; margin-bottom: 16px; }
  .jd-foot-title .jd-more { font-size: 14px; font-weight: 400; }

  .jd-samesub { margin: 0; padding: 0; list-style: none; }
  .jd-samesub li { border-bottom: 1px solid var(--jd-line); }
  .jd-samesub a { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 15px 0; }
  .jd-samesub strong { flex: 1; min-width: 0; font-size: 16px; font-weight: 500; color: var(--jd-text); transition: color .2s; }
  .jd-samesub a:hover strong { color: var(--jd-link); }
  .jd-samesub time { flex: none; font-size: 13px; color: var(--jd-text-3); }

  /* 관련 글 — 색 블록 없는 납작한 카드. 점 색은 카테고리 */
  .jd-rel { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
  .jd-rel a { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 18px 20px; border-radius: 16px; background: rgba(255, 255, 255, .03); border: 1px solid var(--jd-line); transition: background .2s, border-color .2s; }
  .jd-rel a:hover { background: var(--jd-glass); border-color: var(--jd-glass-line); }
  .jd-rel-cat { display: flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; color: var(--jd-text-2); }
  .jd-rel-cat::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--jd-acc); }
  .jd-rel strong { flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-size: 15.5px; line-height: 1.45; font-weight: 600; color: var(--jd-text); }
  .jd-rel time { font-size: 12.5px; color: var(--jd-text-3); }

  #comments > :global(.giscus) { margin-top: 20px; }

  @media (max-width: 760px) {
    .jd-post-head { padding-top: 48px; padding-bottom: 28px; }
    .jd-post-foot { gap: 48px; }
    .jd-prevnext { grid-template-columns: 1fr; gap: 10px; }
    .jd-pn.is-next { grid-column: auto; }
    .jd-samesub a { flex-direction: column; gap: 2px; }
    .jd-rel { grid-template-columns: 1fr; }
  }
</style>
