---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Series from '../../components/Series.astro';
import SeriesBar from '../../components/SeriesBar.astro';
import { render } from 'astro:content';
import { mdxComponents } from '../../components/mdx';
import { getBuildablePosts, getPosts, postHref, postLang, formatDate, readMinutes, buildToc, nbHyphen, splitTitle } from '../../lib/posts';
import { catHref, catOf, tagHref, subLabel, SITE, GISCUS } from '../../lib/site';
import { LANGS, langParam, ui } from '../../lib/i18n';
import { seriesOf } from '../../lib/series';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const [ko, en] = await Promise.all(LANGS.map((l) => getBuildablePosts(l)));
  const enIds = new Set(en.map((p) => p.id));
  const koIds = new Set(ko.map((p) => p.id));
  // alt: 같은 글의 언어별 주소 — 번역이 없는 쪽은 빼서 hreflang 과 언어 전환이 없는 페이지를 가리키지 않게
  const alt = (id: string) => ({ ...(koIds.has(id) && { ko: `/${id}` }), ...(enIds.has(id) && { en: `/en/${id}` }) });
  // 다른 언어판의 제목·태그 — 검색 색인에만 넣어 '고루틴'·'goroutine' 어느 쪽으로 찾아도 같은 글이 나오게 한다
  const terms = (list: typeof ko) => new Map(list.map((p) => [p.id, [p.data.title, ...p.data.tags].join(' · ')]));
  const koTerms = terms(ko);
  const enTerms = terms(en);
  return [...ko, ...en].map((post) => ({
    params: { lang: langParam(postLang(post)), slug: post.id },
    props: { post, alt: alt(post.id), otherTerms: (postLang(post) === 'en' ? koTerms : enTerms).get(post.id) },
  }));
}
const { post, alt, otherTerms } = Astro.props;
const lang = postLang(post);
const t = ui(lang);
const { title, description, pubDate, updatedDate, category, subcategory, tags, stub, tistoryId, hidden } = post.data;
const subName = subLabel(category, subcategory, lang);
const { Content } = await render(post);
const toc = buildToc(post.body);

const list = await getPosts(lang);
const idx = list.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? list[idx - 1] : undefined;
const older = idx >= 0 && idx < list.length - 1 ? list[idx + 1] : undefined;
const sameSub = list.filter((p) => p.id !== post.id && p.data.category === category && p.data.subcategory === subcategory).slice(0, 5);
const related = list
  .filter((p) => p.id !== post.id && !sameSub.includes(p))
  .map((p) => ({ p, s: (p.data.category === category ? 2 : 0) + p.data.tags.filter((t) => tags.includes(t)).length }))
  .filter((x) => x.s > 0)
  .sort((a, b) => b.s - a.s || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 3)
  .map((x) => x.p);
// 시리즈 — 이 언어 목록에 있는 편만 (영어판이 없는 편은 빠진다). 두 편 이상일 때만 보인다
const series = seriesOf(post.id);
const seriesItems = (series?.parts ?? []).flatMap((part) => {
  const p = list.find((x) => x.id === part.id);
  return p ? [{ href: postHref(p), label: part.label[lang], current: p.id === post.id }] : [];
});
const minutes = readMinutes(post.body, lang);
const { main, sub } = splitTitle(title);
const sections = toc.filter((i) => i.depth === 2).length;
---
<Base title={title} description={description} type="article" published={pubDate} modified={updatedDate} image={`/og/${lang === 'en' ? 'en/' : ''}${post.id}.png`} noindex={hidden || stub} alt={alt}>
  <div class="jd-progress" aria-hidden="true"></div>
  <article class="jd-post" data-post={post.id} data-pagefind-body>
    <header class="jd-post-head jd-wrap">
      {/* 분류·날짜·분량은 검색 발췌에 섞이지 않게 색인에서 빼고, 결과 줄에 쓸 메타로만 넘긴다 */}
      <p class="jd-post-cat" data-pagefind-ignore data-pagefind-meta={`cat:${category} · ${subName}`}><a href={catHref(category, undefined, lang)}>{category}</a><span>·</span><a href={catHref(category, subcategory, lang)}>{subName}</a></p>
      <h1 class="jd-post-title jd-grad" data-pagefind-meta="title" tabindex="-1">{nbHyphen(main)}{sub && <><span class="jd-sr"> — </span><span class="jd-post-sub">{sub}</span></>}</h1>
      {otherTerms && <p class="jd-sr" aria-hidden="true" data-pagefind-weight="2">{otherTerms}</p>}
      <p class="jd-post-meta" data-pagefind-ignore>
        <time datetime={pubDate.toISOString()} data-pagefind-meta="date">{formatDate(pubDate, lang)}</time>
        {updatedDate && <span>{t.updated} <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, lang)}</time></span>}
        <span>{t.minutes(minutes)}</span>
      </p>
    </header>

    <div class="jd-post-grid jd-wrap">
      <div class="jd-post-main">
        {series && seriesItems.length > 1 && <SeriesBar title={series.title[lang]} items={seriesItems} />}
        {/* 좁은 화면의 목차 — 접어 두어 첫 화면에 본문이 오게 한다. 읽는 중에는 오른쪽 아래 목차 단추가 같은 목차를 연다 */}
        {toc.length > 5 && (
          <details class="jd-toc-inline" data-pagefind-ignore>
            <summary><span>{t.toc}</span><span class="jd-toc-count">{t.tocCount(sections)}</span><svg class="jd-toc-chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
            <Toc items={toc} />
          </details>
        )}
        {stub && (
          <aside class="jd-stub">
            {t.stub} <a href={`${SITE.tistory}/${tistoryId}`} rel="noopener">{t.stubLink}</a>
          </aside>
        )}
        <div class="prose">
          <Content components={mdxComponents} />
        </div>

        {tags.length > 0 && (
          <ul class="jd-post-tags" aria-label={t.tags}>
            {tags.map((tag) => <li><a href={tagHref(tag, lang)}>#{tag}</a></li>)}
          </ul>
        )}
        {/* 글 링크 복사(JS 가 있을 때만 보인다)·GitHub 에서 고치기 — 오탈자나 틀린 내용을 바로 고쳐 보낼 수 있게 */}
        <div class="jd-post-actions" data-pagefind-ignore>
          <button type="button" class="jd-act" data-copy-link data-done={t.linkCopied} data-anchor={t.sectionLink}>
            <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 9.5l3-3M7 4.5l1.2-1.2a2.6 2.6 0 013.7 3.7L10.7 8.2M9 11.5l-1.2 1.2a2.6 2.6 0 01-3.7-3.7L5.3 7.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>{t.copyLink}
          </button>
          <a class="jd-act" href={`${SITE.repo}/edit/main/${post.filePath}`} rel="noopener" target="_blank">
            <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><path d="M10.5 2.5l3 3L6 13H3v-3l7.5-7.5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>{t.editOnGithub}
          </a>
        </div>
      </div>
      {toc.length > 0 && (
        <aside class="jd-post-aside" data-pagefind-ignore>
          <div class="jd-post-aside-in"><Toc items={toc} /></div>
        </aside>
      )}
    </div>

    <footer class="jd-post-foot jd-wrap" data-pagefind-ignore>
      {series && seriesItems.length > 1 && <Series title={series.title[lang]} items={seriesItems} />}

      {(newer || older) && (
        <nav class="jd-prevnext" aria-label={t.prevNext}>
          {[older && { p: older, dir: t.prev, next: false }, newer && { p: newer, dir: t.next, next: true }].map((x) => x && (
            <a class:list={['jd-pn', 'jd-pan-host', x.next && 'is-next']} href={postHref(x.p)}>
              <span class="jd-pn-ic" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={x.next ? 'M6 3l5 5-5 5' : 'M10 3L5 8l5 5'} /></svg></span>
              <span class="jd-pn-text"><span class="jd-pn-dir">{x.dir}</span><strong class="jd-pan"><span class="jd-pan-in">{x.p.data.title}</span></strong></span>
            </a>
          ))}
        </nav>
      )}

      {sameSub.length > 0 && (
        <section>
          <h2 class="jd-foot-title">{t.sameSub(subName)} <a class="jd-more" href={catHref(category, subcategory, lang)}>{t.seeAll}</a></h2>
          <ul class="jd-samesub">
            {sameSub.map((p) => <li><a href={postHref(p)}><strong>{p.data.title}</strong><time>{formatDate(p.data.pubDate, lang)}</time></a></li>)}
          </ul>
        </section>
      )}

      {related.length > 0 && (
        <section>
          <h2 class="jd-foot-title is-plain">{t.related}</h2>
          <ul class="jd-rel">
            {related.map((p) => (
              <li>
                <a href={postHref(p)} style={`--jd-acc:${catOf(p.data.category)?.acc ?? 'var(--jd-text-3)'}`}>
                  <span class="jd-rel-cat">{p.data.category} · {subLabel(p.data.category, p.data.subcategory, lang)}</span>
                  <strong>{p.data.title}</strong>
                  <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate, lang)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* 댓글은 한국어판·영어판이 같은 스레드를 쓴다 — 주소가 아니라 글 번호로 묶는다 */}
      <section id="comments" aria-label={t.comments}>
        <h2 class="jd-foot-title">{t.comments}</h2>
        {/* giscus 설정 — 아래 스크립트가 화면 모드에 맞는 테마로 giscus 스크립트를 붙인다 */}
        <div
          class="jd-giscus"
          data-repo={GISCUS.repo}
          data-repo-id={GISCUS.repoId}
          data-category={GISCUS.category}
          data-category-id={GISCUS.categoryId}
          data-mapping="specific"
          data-term={`post/${post.id}`}
          data-strict="1"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-lang={lang}
          data-loading="lazy"
        ></div>
      </section>
    </footer>
  </article>

  {/* 읽는 중 목차 — 오른쪽 목차가 없는 폭(1200px 미만)에서 본문을 읽는 동안만 오른쪽 아래에 뜬다. 지금 절 번호를 보여 주고, 누르면 목차 시트가 열린다 */}
  {sections > 2 && (
    <>
      <button type="button" class="jd-tocfab" aria-haspopup="dialog" aria-controls="jd-tocsheet" data-label={t.tocOpen} aria-label={t.tocOpen.replace('{n}', '1').replace('{total}', String(sections))}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h1.5M2 8h1.5M2 12.5h1.5M6 3.5h8M6 8h8M6 12.5h8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        <span class="jd-tocfab-n" aria-hidden="true"><b>1</b>/{sections}</span>
      </button>
      <dialog class="jd-tocsheet" id="jd-tocsheet" aria-label={t.tocAria} closedby="any">
        <div class="jd-tocsheet-in">
          <div class="jd-tocsheet-bar">
            <button type="button" class="jd-tocsheet-top" data-totop>
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 12V2M2.5 6.5L7 2l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>{t.toTop}
            </button>
            <button type="button" class="jd-tocsheet-x" data-sheet-close aria-label={t.close}>
              <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            </button>
          </div>
          <Toc items={toc} />
        </div>
      </dialog>
    </>
  )}
</Base>

<script>
  // 목차: 지금 읽는 섹션 강조. 같은 목차가 여러 벌(오른쪽, 본문 위 접힌 것, 목차 시트) 있어서 id 마다 링크를 모은다
  const links = new Map<string, HTMLAnchorElement[]>();
  document.querySelectorAll<HTMLAnchorElement>('.jd-toc a[data-toc]').forEach((a) => {
    const id = a.dataset.toc!;
    links.set(id, [...(links.get(id) ?? []), a]);
  });
  const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  // 절 번호 — 실습(└) 항목은 바로 위 h2 의 번호를 따른다 (목차 단추의 '3/9')
  const sectionOf = new Map<string, number>();
  {
    let n = 0;
    document.querySelector('.jd-toc')?.querySelectorAll<HTMLAnchorElement>('a[data-toc]').forEach((a) => {
      if (!a.closest('.is-lab')) n++;
      sectionOf.set(a.dataset.toc!, Math.max(1, n));
    });
  }
  const fab = document.querySelector<HTMLButtonElement>('.jd-tocfab');
  const fabN = fab?.querySelector('b');

  // 표시 막대를 그 목차의 지금 항목 위치로 옮긴다. 접혀 있거나 닫힌 목차는 크기가 0 이라 건너뛰고, 펼칠 때 다시 부른다
  const placeInd = (nav: HTMLElement) => {
    const a = nav.querySelector<HTMLElement>('a.is-active');
    if (!a || !a.offsetParent) return;
    nav.style.setProperty('--ind-y', `${a.getBoundingClientRect().top - nav.getBoundingClientRect().top}px`);
    nav.style.setProperty('--ind-h', String(a.offsetHeight)); // scaleY 배율 — 막대 기본 높이가 1px
    nav.classList.add('has-ind');
    // 처음 자리를 잡을 때는 미끄러지지 않고, 그다음부터 움직임을 켠다
    if (!nav.classList.contains('is-ready')) requestAnimationFrame(() => nav.classList.add('is-ready'));
  };
  const placeAll = () => document.querySelectorAll<HTMLElement>('.jd-toc').forEach(placeInd);

  if (targets.length) {
    let active = '';
    const set = (id: string) => {
      if (id === active) return;
      links.get(active)?.forEach((a) => a.classList.remove('is-active'));
      links.get(id)?.forEach((a) => a.classList.add('is-active'));
      active = id;
      placeAll();
      if (fab && fabN) {
        const n = String(sectionOf.get(id) ?? 1);
        fabN.textContent = n;
        fab.setAttribute('aria-label', fab.dataset.label!.replace('{n}', n).replace('{total}', String(Math.max(...sectionOf.values()))));
      }
    };
    const onScroll = () => {
      const y = 120;
      let cur = targets[0].id;
      for (const t of targets) { if (t.getBoundingClientRect().top - y <= 0) cur = t.id; else break; }
      set(cur);
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', placeAll);
    document.querySelector('.jd-toc-inline')?.addEventListener('toggle', placeAll);
    onScroll();
  }

  // 목차 단추 — 글 머리를 지나 본문을 읽는 동안만 보이고, 글 아래(이전·다음, 댓글)에 닿으면 숨는다
  const sheet = document.querySelector<HTMLDialogElement>('#jd-tocsheet');
  if (fab && sheet) {
    const head = document.querySelector('.jd-post-head')!;
    const foot = document.querySelector('.jd-post-foot')!;
    let pastHead = false;
    let atFoot = false;
    const show = () => fab.classList.toggle('is-shown', pastHead && !atFoot);
    new IntersectionObserver(([e]) => { pastHead = !e.isIntersecting && e.boundingClientRect.top < 0; show(); }).observe(head);
    new IntersectionObserver(([e]) => { atFoot = e.isIntersecting || e.boundingClientRect.top < 0; show(); }).observe(foot);

    fab.addEventListener('click', () => {
      sheet.showModal();
      placeInd(sheet.querySelector('.jd-toc')!);
      // 긴 목차면 지금 항목이 시트 안에 보이게 (페이지는 움직이지 않는다)
      const a = sheet.querySelector<HTMLElement>('a.is-active');
      const box = sheet.querySelector<HTMLElement>('.jd-tocsheet-in')!;
      if (a) box.scrollTop = Math.max(0, a.offsetTop - box.clientHeight / 2);
    });
    // 시트 밖(어두운 곳)을 누르면 닫는다 — closedby="any" 를 모르는 브라우저용
    sheet.addEventListener('click', (e) => { if (e.target === sheet) sheet.close(); });
    sheet.querySelector('[data-sheet-close]')!.addEventListener('click', () => sheet.close());
    // 항목을 누르면 시트를 닫고 그 절로 간다 (닫힌 뒤 기본 동작인 # 이동이 일어난다)
    sheet.querySelectorAll('a[data-toc]').forEach((a) => a.addEventListener('click', () => sheet.close()));
    sheet.querySelector('[data-totop]')!.addEventListener('click', () => {
      sheet.close();
      scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      document.querySelector<HTMLElement>('.jd-post-title')?.focus({ preventScroll: true });
    });
  }

  // 제목 옆 링크(#) — 누르면 그 절 주소를 복사한다. 글 링크 복사 단추도 같은 알림을 쓴다
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  if (copyBtn) {
    const copy = (url: string) =>
      navigator.clipboard?.writeText(url).then(() => dispatchEvent(new CustomEvent('jd:toast', { detail: copyBtn.dataset.done }))).catch(() => {});
    document.querySelectorAll<HTMLElement>('.prose :is(h2, h3)[id]').forEach((h) => {
      const a = document.createElement('a');
      a.className = 'jd-anchor';
      a.href = `#${h.id}`;
      a.setAttribute('aria-label', copyBtn.dataset.anchor!);
      a.textContent = '#';
      h.append(a);
    });
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.jd-anchor');
      if (!a) return;
      e.preventDefault();
      history.replaceState(null, '', a.hash);
      copy(location.href);
    });
    copyBtn.addEventListener('click', () => copy(location.origin + location.pathname));
  }

  // 댓글(giscus) — 지금 화면 모드의 테마로 붙이고, 모드가 바뀌면 열린 댓글 창에도 알린다
  const giscus = document.querySelector<HTMLElement>('.jd-giscus');
  if (giscus) {
    const theme = () => (document.documentElement.dataset.theme === 'light' ? 'light' : 'transparent_dark');
    const sc = document.createElement('script');
    sc.src = 'https://giscus.app/client.js';
    sc.async = true;
    sc.crossOrigin = 'anonymous';
    Object.entries(giscus.dataset).forEach(([k, v]) => sc.setAttribute(`data-${k.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`)}`, v!));
    sc.setAttribute('data-theme', theme());
    giscus.after(sc);
    addEventListener('jd:theme', () => {
      document.querySelector<HTMLIFrameElement>('iframe.giscus-frame')?.contentWindow?.postMessage({ giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app');
    });
  }

  // 읽기 진행 막대 대체 동작 — scroll() 타임라인이 없는 브라우저(Firefox 등)만
  const bar = document.querySelector<HTMLElement>('.jd-progress');
  if (bar && !CSS.supports('animation-timeline: scroll()')) {
    let queued = false;
    const update = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  /* 읽은 만큼 차는 막대 — 스크롤 타임라인 지원 브라우저는 CSS 만, 없는 브라우저(Firefox 등)는 위 스크립트가 scaleX 를 넣는다 */
  .jd-progress {
    position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 100;
    background: linear-gradient(90deg, #2997FF, #BF5AF2); transform-origin: 0 50%; transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    .jd-progress {
      /* 단축 속성은 CSS 압축 때 animation-timeline 과 합쳐져 버려지므로 개별 속성으로 쓴다 */
      animation-name: jdProg; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root);
    }
    @keyframes jdProg { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  }

  .jd-post-head { max-width: calc(var(--jd-read) + var(--jd-gutter) * 2); padding-top: 88px; padding-bottom: 48px; }
  .jd-post-cat { display: flex; gap: 8px; margin: 0 0 14px; font-size: 17px; font-weight: 600; }
  .jd-post-cat span { color: var(--jd-text-3); }
