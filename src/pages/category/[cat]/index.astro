---
import ListPage from '../../../components/ListPage.astro';
import SubNav from '../../../components/SubNav.astro';
import { getPosts, countBy } from '../../../lib/posts';
import { CATEGORIES } from '../../../lib/site';
export async function getStaticPaths() {
  return CATEGORIES.map((cat) => ({ params: { cat: cat.slug }, props: { cat } }));
}
const { cat } = Astro.props;
const all = await getPosts();
const posts = all.filter((p) => p.data.category === cat.name);
const counts = countBy(all).sub;
---
<ListPage title={cat.name} posts={posts} crumbs={[{ href: '/category', label: '전체 글' }]} description={cat.desc}>
  <SubNav slot="after-title" cat={cat} counts={counts} />
</ListPage>
