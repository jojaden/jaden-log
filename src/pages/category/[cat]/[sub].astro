---
import ListPage from '../../../components/ListPage.astro';
import SubNav from '../../../components/SubNav.astro';
import { getPosts, countBy } from '../../../lib/posts';
import { CATEGORIES, catHref } from '../../../lib/site';
export async function getStaticPaths() {
  return CATEGORIES.flatMap((cat) => cat.subs.map((sub) => ({ params: { cat: cat.slug, sub: cat.subSlugs[sub] }, props: { cat, sub } })));
}
const { cat, sub } = Astro.props;
const all = await getPosts();
const posts = all.filter((p) => p.data.category === cat.name && p.data.subcategory === sub);
const counts = countBy(all).sub;
---
<ListPage title={sub} eyebrow={cat.name} posts={posts} crumbs={[{ href: '/category', label: '전체 글' }, { href: catHref(cat.name), label: cat.name }]}>
  <SubNav slot="after-title" cat={cat} current={sub} counts={counts} />
</ListPage>
