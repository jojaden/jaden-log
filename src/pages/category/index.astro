---
import ListPage from '../../components/ListPage.astro';
import { getPosts } from '../../lib/posts';
import { CATEGORIES, catHref } from '../../lib/site';
const posts = await getPosts();
---
<ListPage title="전체 글" posts={posts} description="Jaden.log 의 모든 글">
  <nav slot="after-title" class="jd-catnav" aria-label="대분류">
    {CATEGORIES.map((c) => <a href={catHref(c.name)} style={`--jd-acc:${c.acc}`}><i></i>{c.name}</a>)}
  </nav>
</ListPage>
<style>
  .jd-catnav { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .jd-catnav a { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px; border-radius: 980px; font-size: 15px; color: var(--jd-text); background: var(--jd-glass); border: 1px solid var(--jd-glass-line); }
  .jd-catnav a:hover { background: rgba(255, 255, 255, .12); text-decoration: none; }
  .jd-catnav i { width: 8px; height: 8px; border-radius: 50%; background: var(--jd-acc); }
</style>
