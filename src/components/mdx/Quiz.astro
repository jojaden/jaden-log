  .jd-quiz-slot.is-right rect { fill: rgba(48, 209, 88, .2); stroke: #30D158; stroke-dasharray: none; }
  .jd-quiz-slot.is-right text { fill: #30D158; }
  .jd-quiz-slot.is-wrong rect { fill: rgba(255, 69, 58, .2); stroke: #FF453A; stroke-dasharray: none; }
  .jd-quiz-slot.is-wrong text { fill: #FF6961; }
  .jd-quiz-slot rect.jd-quiz-halo { fill: rgba(255, 214, 10, .3); stroke: none; opacity: 0; }

  .jd-quiz .jd-quiz-opts { clear: both; display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .jd-quiz .jd-quiz-opts.is-short { grid-template-columns: repeat(auto-fit, minmax(132px, 1fr)); }
  .jd-quiz .jd-quiz-opts.is-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .jd-quiz .jd-quiz-opts li { margin: 0; }
  /* JS 가 없을 때 — 보기는 상자만, 답은 아래 '답 보기'. 받침은 읽기 전 질문의 안내만 */
  .jd-quiz:not(.is-ready) .jd-quiz-opts li { padding: 12px 16px; border-radius: 14px; background: var(--jd-fill-2); font-size: 16px; line-height: 1.5; color: var(--jd-text); }
  .jd-quiz.is-ready .jd-quiz-fb { display: none; }
  .jd-quiz:not(.is-ready):not([data-pre]) .jd-quiz-tray, .jd-quiz:not(.is-ready) .jd-quiz-act { display: none; }
  .jd-quiz .jd-quiz-fb { margin-top: 14px; font-size: 15px; }
  .jd-quiz .jd-quiz-fb summary { cursor: pointer; color: var(--jd-link); }
  .jd-quiz .jd-quiz-fb p { margin: 10px 0 0; }

  /* 보기 — 선 없이 한 단계 밝은 면. 고르면 안쪽 고리(자리를 밀지 않는다)와 파란 점, 맞으면 초록 체크, 틀리면 빨강 X */
  .jd-quiz-opt {
    display: flex; align-items: center; gap: 12px; width: 100%; min-height: 54px; padding: 13px 16px;
    border: 0; border-radius: 14px; background: var(--jd-fill-2); box-shadow: inset 0 0 0 1.5px transparent;
    font: 500 16px/1.5 var(--jd-font); color: var(--jd-text); text-align: left; cursor: pointer;
    transition: background-color .15s var(--jd-ease-out), box-shadow .15s var(--jd-ease-out), opacity .2s, transform .16s var(--jd-ease-out);
  }
  .jd-quiz-mk {
    position: relative; flex: none; display: grid; place-items: center; width: 22px; height: 22px;
    border-radius: 50%; border: 1.5px solid var(--jd-glass-line-2); transition: background-color .15s, border-color .15s;
  }
  .jd-quiz-mk svg { width: 14px; height: 14px; color: var(--jd-canvas); }
  .jd-quiz-mk path { fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 20; stroke-dashoffset: 20; }
  .jd-quiz-opt:is(.is-picked, .is-guess) { background: color-mix(in srgb, var(--jd-link) 12%, var(--jd-fill-2)); box-shadow: inset 0 0 0 1.5px var(--jd-link); }
  .jd-quiz-opt:is(.is-picked, .is-guess) .jd-quiz-mk { border-color: var(--jd-link); box-shadow: inset 0 0 0 4px var(--jd-canvas); background: var(--jd-link); }
  .jd-quiz-opt.is-right .jd-quiz-mk { border-color: var(--jd-ok); background: var(--jd-ok); box-shadow: none; }
  .jd-quiz-opt.is-right .y { stroke-dashoffset: 0; }
  .jd-quiz-opt.is-wrong .jd-quiz-mk { border-color: var(--jd-bad); background: var(--jd-bad); box-shadow: none; }
  .jd-quiz-opt.is-wrong .x { stroke-dashoffset: 0; }

  /* 이름표 칩 — 그림 아래 놓인 타일. 빈칸으로 날아간 칩의 자리는 빈 테두리만 남는다 */
  .jd-quiz-chip {
    min-height: 46px; padding: 0 18px; border: 0; border-radius: 12px; background: var(--jd-fill-2); box-shadow: inset 0 0 0 1.5px transparent;
    font: 600 15.5px var(--jd-font); color: var(--jd-text); cursor: pointer;
    transition: background-color .15s var(--jd-ease-out), box-shadow .15s var(--jd-ease-out), opacity .2s, transform .16s var(--jd-ease-out);
  }
  .jd-quiz-chip.is-picked { opacity: .5; background: transparent; box-shadow: inset 0 0 0 1.5px var(--jd-glass-line-2); }
  .jd-quiz-chip.is-guess { background: color-mix(in srgb, var(--jd-link) 12%, var(--jd-fill-2)); box-shadow: inset 0 0 0 1.5px var(--jd-link); }
  .jd-quiz-ghost { position: fixed; z-index: 400; margin: 0; pointer-events: none; display: flex; align-items: center; justify-content: center; white-space: nowrap; }
  .jd-quiz :is(.jd-quiz-opt, .jd-quiz-chip).is-right { background: var(--jd-ok-bg); box-shadow: inset 0 0 0 1.5px var(--jd-ok); opacity: 1; }
  .jd-quiz :is(.jd-quiz-opt, .jd-quiz-chip).is-wrong { background: var(--jd-bad-bg); box-shadow: inset 0 0 0 1.5px var(--jd-bad); opacity: 1; }
  .jd-quiz-chip.is-wrong { text-decoration: line-through; text-decoration-color: var(--jd-bad); }
  .jd-quiz :is(.jd-quiz-opt, .jd-quiz-chip)[aria-disabled] { cursor: default; }
  .jd-quiz:is([data-state='right'], [data-state='wrong'], [data-state='guess']) :is(.jd-quiz-opt, .jd-quiz-chip):not(.is-right, .is-wrong, .is-guess) { opacity: .4; }
  .jd-quiz :is(.jd-quiz-opt, .jd-quiz-chip, .jd-quiz-btn):focus-visible { outline: 2px solid var(--jd-link); outline-offset: 2px; }

  /* 받침 — 상자 바닥의 띠 하나. 고르기 전엔 확신도 단추가 흐리게 기다리고, 고르면 켜지고, 누르면 같은 자리가 결과로 바뀌며 초록·빨강으로 물든다.
     결과가 누른 손가락 바로 그 자리에서 나오니 눈이 위아래로 오가지 않는다 */
  .jd-quiz .jd-quiz-tray {
    margin: 22px -26px 0; padding: 16px 26px 20px; scroll-margin-bottom: 80px;
    background: var(--jd-fill-1); transition: background-color .25s var(--jd-ease-out);
  }
  .jd-quiz[data-state='right'] .jd-quiz-tray { background: var(--jd-ok-bg); }
  .jd-quiz:is([data-state='wrong'], [data-state='again']) .jd-quiz-tray { background: var(--jd-bad-bg); }
  .jd-quiz[data-state='guess'] .jd-quiz-tray { background: color-mix(in srgb, var(--jd-link) 10%, transparent); }
  .jd-quiz .jd-quiz-ask { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 16px; min-height: 44px; }
  .jd-quiz .jd-quiz-ask[hidden] { display: none; }
  .jd-quiz .jd-quiz-ask p { margin: 0; font-size: 15px; font-weight: 600; color: var(--jd-text-2); }
