  .jd-quiz .jd-quiz-verdict strong { font-weight: 700; color: var(--jd-text); }
  .jd-quiz[data-state='right'] .jd-quiz-verdict strong { color: var(--jd-ok); }
  .jd-quiz:is([data-state='wrong'], [data-state='again']) .jd-quiz-verdict strong { color: var(--jd-bad); }
  .jd-quiz-ic { flex: none; width: 22px; height: 22px; padding: 4px; box-sizing: border-box; border-radius: 50%; fill: none; stroke: var(--jd-canvas); stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 20; }
  .jd-quiz[data-state='right'] .jd-quiz-ic { background: var(--jd-ok); }
  .jd-quiz:is([data-state='wrong'], [data-state='again']) .jd-quiz-ic { background: var(--jd-bad); }

  /* 다음 할 일 — 받침 안이라 테 없는 글자 단추 (애플의 plain 단추). 누르는 자리는 44px */
  .jd-quiz .jd-quiz-act { display: flex; flex-wrap: wrap; gap: 0 22px; margin-top: 6px; }
  .jd-quiz :is(.jd-quiz-act, .jd-quiz-btn)[hidden], .jd-quiz[data-state='guess'] .jd-quiz-next { display: none; }
  .jd-quiz .jd-quiz-act .jd-quiz-btn { min-height: 44px; padding: 0; border-radius: 0; background: none; color: var(--jd-link); font-size: 15px; transition: opacity .15s; }
  .jd-quiz .jd-quiz-act .jd-quiz-next { color: var(--jd-text-2); }
  .jd-quiz-btn {
    min-height: 44px; padding: 0 18px; border: 0; border-radius: 980px; background: var(--jd-fill-2);
    font: 600 14.5px var(--jd-font); color: var(--jd-text); cursor: pointer;
    transition: background-color .15s, opacity .15s, transform .16s var(--jd-ease-out);
  }

  /* 폰에서 앱처럼 — 누르면 바로 반응(두 번 눌러 확대 기다림 없음), 길게 눌러도 단추 글자가 잡히지 않게 */
  .jd-quiz :is(.jd-quiz-opt, .jd-quiz-chip, .jd-quiz-btn, .jd-quiz-dot), .jd-quiz-back, .jd-quiz-card :is(a, button) {
    touch-action: manipulation; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;
  }

  /* 읽기 전 질문의 '내 짐작' — 답이 나오는 문단 바로 뒤. 독자가 여기까지 읽으면 떠오른다 */
  .jd-quiz-echo { margin: 20px 0 28px; padding: 16px 18px; border-radius: 16px; background: color-mix(in srgb, var(--jd-link) 8%, var(--jd-fill-1)); transition: opacity .2s; }
  .jd-quiz-echo:not(.is-in) { opacity: 0; }
  .prose .jd-quiz-echo p { margin: 0; font-size: 15.5px; line-height: 1.65; color: var(--jd-body); }
  .prose .jd-quiz-echo .jd-quiz-echo-row { margin: 0 0 10px; }
  .prose .jd-quiz-echo dt { margin: 0; font-size: 13px; font-weight: 600; color: var(--jd-text-3); }
  .prose .jd-quiz-echo dd { margin: 2px 0 8px; font-size: 15.5px; font-weight: 700; line-height: 1.5; }
  .jd-quiz-echo dd.is-ok { color: var(--jd-ok); }
  .jd-quiz-echo dd.is-bad { color: var(--jd-bad); text-decoration: line-through; }
  .jd-quiz-echo dd em { margin-left: 6px; font-style: normal; font-weight: 600; }

  /* 결과·복습 카드 — 첫 줄이 할 일(다시 볼 곳, 남은 문제, 복습할 문제), 점수는 그 아래 한 줄 */
  .jd-quiz-card { margin: 48px 0; padding: 26px; border-radius: 22px; border: 1px solid var(--jd-glass-line); background: var(--jd-fill-1); scroll-margin-top: 96px; }
  .jd-quiz-card .jd-quiz-big { margin: 0; font-size: 24px; line-height: 1.35; font-weight: 700; letter-spacing: -.02em; color: var(--jd-text); }
  .jd-quiz-card .jd-quiz-sub { margin: 6px 0 0; font-size: 15px; line-height: 1.6; color: var(--jd-text-2); font-variant-numeric: tabular-nums; }
  .jd-quiz-card .jd-quiz-list { display: grid; gap: 2px; margin: 16px -10px 0; padding: 0; list-style: none; }
  .jd-quiz-card .jd-quiz-list li { margin: 0; }
  .jd-quiz-card .jd-quiz-list a { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 12px; font-size: 15.5px; color: var(--jd-text); text-decoration: none; transition: background .2s; }
  .jd-quiz-card .jd-quiz-list .jd-quiz-dot { flex: none; }
  .jd-quiz-card .jd-quiz-tag { flex: none; padding: 2px 8px; border-radius: 6px; background: var(--jd-bad-bg); font-size: 12.5px; font-style: normal; font-weight: 600; color: var(--jd-bad); }
  .jd-quiz-go { flex: none; width: 16px; height: 16px; margin-left: auto; fill: none; stroke: var(--jd-text-3); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .jd-quiz-card .jd-quiz-btn { margin-top: 14px; }

  /* 마우스가 있는 기기에서만 — 터치에서는 누른 뒤 hover 가 남는다 */
  @media (hover: hover) and (pointer: fine) {
    .jd-quiz:not([data-state='right'], [data-state='wrong'], [data-state='guess']) :is(.jd-quiz-opt, .jd-quiz-chip):not([aria-disabled]):hover { background: var(--jd-fill-3); }
    .jd-quiz-btn:not([aria-disabled]):hover { background: var(--jd-fill-3); }
    .jd-quiz .jd-quiz-act .jd-quiz-btn:hover { background: none; opacity: .75; }
    .jd-quiz-card .jd-quiz-list a:hover { background: var(--jd-fill-2); }
  }

  /* 움직임은 짧게, 한 번만 — 결과는 받침에서 판정 → 이유 → 다음 할 일 순으로 40ms 씩 떠오르고, 판정 아이콘은 그려진다.
     보기는 틀리면 짧게 흔들리고, 그림 문제는 빈칸만 움직인다. 화면에 남는 장식은 두지 않는다 */
  @media (prefers-reduced-motion: no-preference) {
    .jd-quiz :is(.jd-quiz-opt, .jd-quiz-chip):active:not([aria-disabled]), .jd-quiz-btn:active:not([aria-disabled]) { transform: scale(.97); }
    .jd-quiz .jd-quiz-act .jd-quiz-btn:active { transform: none; opacity: .55; }
    .jd-quiz-mk path { transition: stroke-dashoffset .3s var(--jd-ease-out) .05s; }
    .jd-quiz-opt.is-chosen.is-wrong { animation: jdQuizShake .3s var(--jd-ease-out); }
    .jd-quiz-slot { transform-box: fill-box; transform-origin: center; }
    .jd-quiz-slot.is-right { animation: jdQuizPop .3s var(--jd-ease-out); }
    .jd-quiz-slot.is-wrong { animation: jdQuizShake .3s var(--jd-ease-out); }
    .jd-quiz.is-seen .jd-quiz-slot:not(.is-filled, .is-right, .is-wrong) .jd-quiz-halo { animation: jdQuizGlow 1.2s ease-in-out 2; }
    .jd-quiz .jd-quiz-res > *, .jd-quiz .jd-quiz-act:not([hidden]) { animation: jdQuizIn .22s var(--jd-ease-out) backwards; }
    .jd-quiz .jd-quiz-res > :nth-child(2) { animation-delay: .04s; }
    .jd-quiz .jd-quiz-act:not([hidden]) { animation-delay: .08s; }
    .jd-quiz-ic path { animation: jdQuizDraw .3s var(--jd-ease-out) .05s backwards; }
    .jd-quiz-echo { transition: opacity .3s var(--jd-ease-out), transform .3s var(--jd-ease-out); }
    .jd-quiz-echo:not(.is-in) { transform: translateY(8px); }
  }
  @keyframes jdQuizPop { 0%, 100% { transform: scale(1); } 40% { transform: scale(.96); } }
  @keyframes jdQuizShake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-4px); } 50% { transform: translateX(4px); } 75% { transform: translateX(-2px); } }
  @keyframes jdQuizIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes jdQuizGlow { 50% { opacity: 1; } }
  @keyframes jdQuizDraw { from { stroke-dashoffset: 20; } }

  /* 문제로 돌아가기 — 목차 단추(오른쪽 아래)와 같은 재질로 왼쪽 아래. 들어올 때보다 나갈 때 빠르다 */
  .jd-quiz-back {
    position: fixed; z-index: 80; left: max(16px, env(safe-area-inset-left)); bottom: max(16px, env(safe-area-inset-bottom));
    display: inline-flex; align-items: center; gap: 6px; height: 48px; padding: 0 18px 0 13px;
    border-radius: 980px; border: 1px solid var(--jd-glass-line);
    background: var(--jd-bar); -webkit-backdrop-filter: blur(24px) saturate(170%); backdrop-filter: blur(24px) saturate(170%);
    box-shadow: var(--jd-glass-hi), 0 10px 30px -12px var(--jd-shadow);
    color: var(--jd-text); font: 600 14px var(--jd-font); cursor: pointer;
    opacity: 0; visibility: hidden; transform: translateY(12px);
    transition: opacity .15s var(--jd-ease-out), transform .15s var(--jd-ease-out), visibility 0s .15s;
  }
  .jd-quiz-back.is-on { opacity: 1; visibility: visible; transform: none; transition: opacity .2s var(--jd-ease-out), transform .25s var(--jd-ease-out), visibility 0s; }
  .jd-quiz-back svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .jd-quiz-back:focus-visible { outline: 2px solid var(--jd-link); outline-offset: 2px; }
  @media (prefers-reduced-motion: no-preference) { .jd-quiz-back.is-on:active { transform: scale(.97); } }
  @media (prefers-reduced-motion: reduce) { .jd-quiz-back, .jd-quiz-back.is-on { transform: none; } }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) { .jd-quiz-back { background: var(--jd-solid); -webkit-backdrop-filter: none; backdrop-filter: none; } }
  @media print { .jd-quiz-back { display: none; } }

  /* 본문에서 보기 — 근거 구절의 형광펜. 형광펜 토큰(--jd-mark)의 두 테마 값 사이 색을 직접 쓴다 (::highlight 안에서는 변수가 안 풀리는 브라우저가 있다) */
  ::highlight(jd-quiz-at) { background-color: rgba(255, 210, 0, .38); }

  @media (max-width: 760px) {
    .jd-quiz, .jd-quiz-card { padding: 22px 18px; margin-left: -4px; margin-right: -4px; }
    .jd-quiz:is(.is-ready, [data-pre]) { padding-bottom: 0; }
    .jd-quiz .jd-quiz-tray { margin: 20px -18px 0; padding: 14px 18px 18px; }
    .jd-quiz .jd-quiz-q { font-size: 18px; }
    .jd-quiz .jd-quiz-fig { padding: 20px 10px 10px; }
    .jd-quiz-card .jd-quiz-big { font-size: 21px; }
  }
</style>
