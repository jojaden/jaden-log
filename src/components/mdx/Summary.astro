---
/** 세 줄 요약 — 도입 문단 바로 뒤. 안에 마크다운 번호 목록(1. 2. 3.)을 쓴다 (티스토리의 💡 세 줄 요약 ①②③).
 *  상자 없이 가로 세 칸 — 칸마다 위에 얇은 선과 작은 번호. 좁은 화면에서는 위아래 */
import { langOf, ui } from '../../lib/i18n';
const t = ui(langOf(Astro.url));
interface Props { title?: string }
const { title = t.summary } = Astro.props;
---
<aside class="jd-sum" aria-label={title}>
  <p class="jd-sum-title">{title}</p>
  <slot />
</aside>
<style>
  .jd-sum { margin: 0 0 52px; }
  .jd-sum-title { margin: 0 0 14px !important; font-size: 13px; font-weight: 700; letter-spacing: .04em; color: var(--jd-new); }
  .jd-sum :global(ol) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; margin: 0; padding: 0; list-style: none; counter-reset: jd-sum; }
  .jd-sum :global(li) { margin: 0; padding-top: 14px; border-top: 1px solid var(--jd-glass-line-2); font-size: 15.5px; line-height: 1.65; counter-increment: jd-sum; }
  .jd-sum :global(li::before) {
    content: counter(jd-sum, decimal-leading-zero); display: block; margin-bottom: 10px;
    font-size: 13px; font-weight: 700; letter-spacing: .02em; font-variant-numeric: tabular-nums; color: var(--jd-text-3);
  }
  @media (max-width: 760px) {
    .jd-sum :global(ol) { grid-template-columns: 1fr; gap: 18px; }
    .jd-sum :global(li::before) { margin-bottom: 6px; }
  }
</style>
