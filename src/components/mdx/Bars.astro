---
/** 막대 비교 — 화면에 들어오면 0 에서 값까지 자란다 (Base.astro 가 .is-in). hi 는 강조할 항목.
 *  shrink 는 값이 위에서 아래로 줄어드는 목록용 — 가득 찬 데서 출발해, k 번째 단계에 k 번째 이하 줄이 함께 k 번째 값까지 깎인다 (계단식) */
interface Props {
  title?: string;
  note?: string;
  shrink?: boolean;
  items: { label: string; value: number; display?: string; hi?: boolean }[];
}
const { title, note, shrink = false, items } = Astro.props;
const max = Math.max(...items.map((i) => i.value));
---
<figure class:list={['jd-bars', { 'is-shrink': shrink }]}>
  {title && <figcaption class="jd-bars-title">{title}</figcaption>}
  <ul>
    {items.map((it, i) => (
      <li class:list={{ 'is-hi': it.hi }} style={`--v:${it.value / max};--i:${i}`}>
        <span class="jd-bar-label">{it.label}</span>
        <span class="jd-bar-track">
          <span class="jd-bar-fill"></span>
          {/* 깎여 나갈 조각 — k 번째 단계에 [k 번째 값, k-1 번째 값] 구간이 사라진다. 오른쪽 조각이 위에 오도록 k 를 거꾸로 */}
          {shrink && items.slice(1, i + 1).map((_, j) => i - j).map((k) => (
            <span class="jd-bar-cut" style={`--a:${items[k].value / max};--b:${items[k - 1].value / max};--k:${k}`}></span>
          ))}
        </span>
        <span class="jd-bar-value">{it.display ?? it.value.toLocaleString('ko-KR')}</span>
      </li>
    ))}
  </ul>
  {note && <p class="jd-bars-note">{note}</p>}
</figure>
<style>
  .jd-bars { margin: 30px 0; padding: 22px 24px; border-radius: 18px; background: var(--jd-glass); border: 1px solid var(--jd-glass-line); }
  .jd-bars-title { margin: 0 0 16px; font-size: 14px; font-weight: 700; color: var(--jd-text); }
  .jd-bars ul { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .jd-bars li { display: grid; grid-template-columns: 9em minmax(0, 1fr) 5.5em; align-items: center; gap: 14px; margin: 0; font-size: 14px; }
  .jd-bar-label { color: var(--jd-text-2); overflow-wrap: anywhere; }
  .jd-bar-track { position: relative; height: 12px; border-radius: 6px; background: var(--jd-fill-2); overflow: hidden; }
  /* 너무 작은 값도 보이게 최소 4px */
  .jd-bar-fill { display: block; height: 100%; min-width: 4px; border-radius: 6px; background: color-mix(in srgb, var(--jd-text) 32%, transparent); transform-origin: left; transform: scaleX(var(--v)); }
  /* 이음매가 둥근 모서리로 패이지 않게 왼쪽으로 6px 겹친다. 기본(움직임 줄이기)은 다 깎인 상태 */
  .jd-bar-cut { position: absolute; inset: 0 auto 0 calc(var(--a) * 100% - 6px); width: calc((var(--b) - var(--a)) * 100% + 6px); border-radius: 0 6px 6px 0; background: color-mix(in srgb, var(--jd-text) 32%, transparent); transform-origin: left; transform: scaleX(0); }
  .is-hi .jd-bar-fill, .is-hi .jd-bar-cut { background: var(--jd-link); }
  /* shrink 목록은 위 줄에서 아래 줄로 넘어간다는 화살표를 줄 사이에 둔다 */
  .is-shrink ul { gap: 26px; }
  .is-shrink li { position: relative; }
  /* 가로 위치는 막대 칸의 가운데 — 라벨 9em · 값 5.5em · 칸 사이 14px 두 번을 뺀 폭의 절반 */
  .is-shrink li + li::before { content: '↓'; position: absolute; left: calc(9em + 14px + (100% - 14.5em - 28px) / 2); top: -23px; transform: translateX(-50%); font-size: 14px; line-height: 20px; font-weight: 700; color: var(--jd-link); }
  .jd-bar-value { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--jd-text-2); }
  .is-hi .jd-bar-label, .is-hi .jd-bar-value { color: var(--jd-text); }
  .jd-bars-note { margin: 14px 0 0 !important; font-size: 12.5px; color: var(--jd-text-3); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.jd-rise-js) .jd-bars:not(.is-in) .jd-bar-fill { transform: scaleX(0); }
    .jd-bar-fill { transition: transform 1.1s var(--jd-ease-out) calc(var(--i) * .12s + .1s); }
    :global(.jd-rise-js) .jd-bars.is-shrink:not(.is-in) .jd-bar-fill { transform: scaleX(var(--v)); }
    :global(.jd-rise-js) .jd-bars:not(.is-in) .jd-bar-cut { transform: scaleX(1); }
    /* 깎이는 움직임은 들어올 때만 — 화면을 벗어나 되돌아갈 때는 단계 지연 없이 바로 가득 찬 상태로 */
    .is-in .jd-bar-cut { transition: transform .6s var(--jd-ease-out) calc((var(--k) - 1) * .75s + .3s); }
    /* 화살표는 자기 아래 줄이 깎이는 단계에 맞춰 켜진다 */
    :global(.jd-rise-js) .jd-bars.is-shrink:not(.is-in) li + li::before { color: var(--jd-text-3); }
    .is-shrink.is-in li + li::before { transition: color .3s calc((var(--i) - 1) * .75s + .3s); }
  }
  @media (max-width: 760px) {
    .jd-bars { padding: 18px; }
    .jd-bars li { grid-template-columns: minmax(0, 1fr) auto; row-gap: 6px; }
    .jd-bar-track { grid-column: 1 / -1; grid-row: 2; }
    .is-shrink li + li::before { left: 50%; } /* 막대가 한 줄을 다 쓰니 가운데 */
  }
</style>
