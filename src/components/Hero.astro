---
import { siteText, CATEGORIES, catHref } from '../lib/site';
import { getPosts, countBy } from '../lib/posts';
import { langOf, ui } from '../lib/i18n';
const lang = langOf(Astro.url);
const t = ui(lang);
const counts = countBy(await getPosts(lang)).top;
---
<section class="jd-hero" aria-label={t.heroAria}>
  <h1 class="jd-hero-title jd-grad">{t.heroTitle[0]}<br />{t.heroTitle[1]}</h1>
  <p class="jd-hero-sub">{siteText(lang).heroSub}</p>
  {/* 다루는 주제를 첫 화면에서 바로 — 칩을 누르면 그 주제의 글 목록으로 */}
  <ul class="jd-hero-topics" aria-label={t.heroTopics}>
    {CATEGORIES.map((c) => (
      <li><a href={catHref(c.name, undefined, lang)} style={`--jd-acc:${c.acc}`}><i aria-hidden="true"></i>{c.name}<em>{t.count(counts.get(c.name) ?? 0)}</em></a></li>
    ))}
  </ul>
</section>
<style>
  .jd-hero { text-align: center; padding: 104px 0 124px; }
  .jd-hero-title { margin: 0; font-size: clamp(42px, 7vw, 92px); line-height: 1.05; font-weight: 700; letter-spacing: -.035em; padding-bottom: .04em; text-wrap: balance; }
  .jd-hero-sub { margin: 26px auto 0; max-width: 640px; font-size: clamp(18px, 2vw, 23px); line-height: 1.42; color: var(--jd-text-2); text-wrap: balance; }
  .jd-hero-topics { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 38px 0 0; padding: 0; list-style: none; }
  .jd-hero-topics a {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 20px 0 18px; border-radius: 980px;
    background: var(--jd-glass); border: 1px solid var(--jd-glass-line); box-shadow: var(--jd-glass-hi);
    font-size: 17px; font-weight: 600; color: var(--jd-text); transition: background .2s, border-color .2s;
  }
  .jd-hero-topics a:hover { background: var(--jd-glass-2); border-color: var(--jd-glass-line-2); text-decoration: none; }
  .jd-hero-topics i { width: 9px; height: 9px; border-radius: 50%; background: var(--jd-acc); }
  .jd-hero-topics em { font-style: normal; font-weight: 500; font-size: 14px; color: var(--jd-text-3); font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: no-preference) { .jd-hero-topics a:active { transform: scale(.97); } }
  @media (max-width: 760px) {
    .jd-hero-topics { gap: 8px; margin-top: 30px; }
    .jd-hero-topics a { min-height: 44px; padding: 0 16px 0 14px; font-size: 15px; gap: 8px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .jd-hero > * { animation: jdHeroIn 1.1s var(--jd-ease-out) both; }
    .jd-hero > :nth-child(2) { animation-delay: .08s; }
    .jd-hero > :nth-child(3) { animation-delay: .16s; }
    /* 스크롤로 화면 위로 빠져나갈 때 살짝 작아지며 흐려진다 — 등장 애니메이션과 겹치지 않게 부모에 건다.
       animation 단축 속성을 쓰면 CSS 압축 때 animation-timeline 까지 한 줄로 합쳐져 브라우저가 버리므로 개별 속성으로 쓴다 */
    @supports (animation-timeline: view()) {
      .jd-hero {
        animation-name: jdHeroOut; animation-timing-function: linear; animation-fill-mode: both;
        animation-timeline: view(); animation-range: exit 10% exit 100%;
      }
    }
  }
  @keyframes jdHeroOut { to { opacity: 0; transform: scale(.92); } }
  @media (max-width: 760px) { .jd-hero { padding: 64px 0 72px; } }
</style>

<script>
  // 스크롤로 빠져나가는 효과의 대체 동작 — animation-timeline 이 없는 브라우저(Firefox 등)만.
  // CSS 의 view() exit 10%~100% 와 같은 곡선: 기준선은 화면 위가 아니라 scroll-padding-top(고정 메뉴 아래)
  const hero = document.querySelector<HTMLElement>('.jd-hero');
  if (hero && !CSS.supports('animation-timeline: view()') && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    let start = 0, span = 1, queued = false;
    const measure = () => {
      hero.style.transform = '';
      const r = hero.getBoundingClientRect();
      const inset = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      start = r.top + scrollY - inset + r.height * 0.1;
      span = r.height * 0.9;
    };
    const update = () => {
      queued = false;
      const p = Math.min(1, Math.max(0, (scrollY - start) / span));
      hero.style.opacity = String(1 - p);
      hero.style.transform = p ? `scale(${1 - 0.08 * p})` : '';
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', () => { measure(); update(); });
    measure();
    update();
  }
</script>
