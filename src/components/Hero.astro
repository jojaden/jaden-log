---
/**
 * 홈 첫 화면 — 슬로건, 그 아래 무대에 최근 글의 표지 창(MacWindow)을 크게 띄운다.
 * 가운데는 새 글(코드 뒤에 실행 결과가 겹친 창), 양옆은 그다음 두 글이 비스듬히 물러나 있고, 창 뒤로 각 글의 주제 색이 번진다.
 * 무대 아래에 새 글의 제목·요약·읽기 단추. 창은 장식이라 읽기 도구에서는 숨기고, 마우스로는 눌러서 그 글로 간다
 */
import MacWindow from './MacWindow.astro';
import { siteText, catHref, catOf, subLabel } from '../lib/site';
import { type Post, postHref, splitTitle, nbHyphen, formatDate, extractCover } from '../lib/posts';
import { langOf, ui } from '../lib/i18n';
interface Props { posts: Post[] } // 최근 글 세 편 — 첫 편이 새 글
const lang = langOf(Astro.url);
const t = ui(lang);
const [lead, ...others] = Astro.props.posts.map((p) => ({ p, cat: catOf(p.data.category), cover: extractCover(p.body) }));
const sides = others.filter((x) => x.cover).slice(0, 2);
const leadTitle = lead && splitTitle(lead.p.data.title);
---
<section class="jd-hero" aria-label={t.heroAria}>
  <div class="jd-hero-text">
    <h1 class="jd-hero-title jd-grad">{t.heroTitle[0]}<br />{t.heroTitle[1]}</h1>
    <p class="jd-hero-sub">{siteText(lang).heroSub}</p>
  </div>

  {lead && leadTitle && (
    <div class="jd-stage">
      <div class="jd-stage-art" aria-hidden="true">
        {sides.map((x, i) => x.cover && (
          <a class:list={['jd-stage-side', i ? 'is-r' : 'is-l']} href={postHref(x.p)} tabindex="-1" style={x.cat ? `--jd-acc:${x.cat.acc}` : undefined}>
            <MacWindow win={x.cover.front} />
          </a>
        ))}
        <a class="jd-stage-main" href={postHref(lead.p)} tabindex="-1" style={lead.cat ? `--jd-acc:${lead.cat.acc}` : undefined}>
          {lead.cover ? (
            <span class="jd-stage-stack">
              {lead.cover.back && <span class="jd-stage-back"><MacWindow win={lead.cover.back} /></span>}
              <span class="jd-stage-front"><MacWindow win={lead.cover.front} /></span>
            </span>
          ) : <span class="jd-stage-tile">{subLabel(lead.p.data.category, lead.p.data.subcategory, lang)}</span>}
        </a>
      </div>
      <article class="jd-stage-cap" style={lead.cat ? `--jd-acc:${lead.cat.acc}` : undefined}>
        <h2 class="jd-stage-title"><a href={postHref(lead.p)}>{nbHyphen(leadTitle.main)}</a></h2>
        {leadTitle.sub && <p class="jd-stage-sub">{leadTitle.sub}</p>}
        {lead.p.data.description && <p class="jd-stage-desc">{lead.p.data.description}</p>}
        <p class="jd-stage-meta">
          <span class="jd-stage-new">{t.newPost}</span>
          <a href={catHref(lead.p.data.category, lead.p.data.subcategory, lang)}><i aria-hidden="true"></i>{lead.p.data.category} · {subLabel(lead.p.data.category, lead.p.data.subcategory, lang)}</a>
          <time datetime={lead.p.data.pubDate.toISOString()}>{formatDate(lead.p.data.pubDate, lang)}</time>
        </p>
        <a class="jd-pill jd-stage-go" href={postHref(lead.p)}>{t.read}</a>
      </article>
    </div>
  )}
</section>
<style>
  .jd-hero { padding: 104px 0 128px; }
  .jd-hero-text { text-align: center; }
  .jd-hero-title { margin: 0; font-size: clamp(42px, 7vw, 92px); line-height: 1.05; font-weight: 700; letter-spacing: -.035em; padding-bottom: .04em; text-wrap: balance; }
  .jd-hero-sub { margin: 26px auto 0; max-width: 640px; font-size: clamp(18px, 2vw, 23px); line-height: 1.42; color: var(--jd-text-2); text-wrap: balance; }

  /* 무대 — 세 창을 한 칸에 겹쳐 놓고 양옆 창만 비켜 세운다 */
  .jd-stage { margin-top: 88px; }
  .jd-stage-art { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); place-items: center; min-height: clamp(380px, 38vw, 500px); perspective: 1800px; } /* 열 폭을 무대 폭으로 묶어 창의 % 폭이 화면을 기준으로 잡히게 */
  .jd-stage-art > * { grid-area: 1 / 1; display: flex; justify-content: center; color: inherit; text-decoration: none !important; }
  /* 창 뒤 주제 색 번짐 */
  .jd-stage-art > *::before {
    content: ""; position: absolute; z-index: -1; inset: -14% -18%; pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--jd-acc, #2997FF) 34%, transparent), transparent);
  }
  .jd-stage-main { position: relative; z-index: 2; width: min(640px, 100%); }
  .jd-stage-stack { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; }
  .jd-stage-stack > * { grid-area: 1 / 1; display: flex; min-width: 0; }
  .jd-stage-stack :global(.jd-win) { max-width: none; }
  /* 앞 창(코드)은 불투명하게 — 뒤 창(실행 결과) 글자가 비치지 않게. 뒤 창은 오른쪽 위로 비켜 선다 */
  .jd-stage-back + .jd-stage-front :global(.jd-win) { background: #111114; }
  .jd-stage-back { justify-self: end; align-self: start; width: 74%; margin-bottom: 132px; opacity: .8; }
  .jd-stage-back + .jd-stage-front { justify-self: start; align-self: end; width: 84%; margin-top: 104px; }
  .jd-stage-front { z-index: 1; }
  .jd-stage-front :global(.jd-win), .jd-stage-back :global(.jd-win) { box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .85); }
  .jd-stage-tile { padding: 56px; font-size: clamp(40px, 4.4vw, 64px); font-weight: 700; letter-spacing: -.025em; color: var(--jd-text); }
  /* 양옆 창 — 안쪽으로 비스듬히 돌아선 채 뒤로 물러나 있고, 마우스를 올리면 조금 다가온다 */
  .jd-stage-side { position: relative; z-index: 1; width: min(420px, 36%); opacity: .5; transition: opacity .6s var(--jd-ease-out), transform .8s var(--jd-spring); }
  .jd-stage-side.is-l { transform: translateX(-92%) rotateY(22deg) scale(.84); }
  .jd-stage-side.is-r { transform: translateX(92%) rotateY(-22deg) scale(.84); }
  .jd-stage-side :global(.jd-win) { box-shadow: 0 30px 60px -28px rgba(0, 0, 0, .9); }
  @media (hover: hover) {
    .jd-stage-side:hover { opacity: .85; }
    .jd-stage-side.is-l:hover { transform: translateX(-96%) rotateY(14deg) scale(.88); }
    .jd-stage-side.is-r:hover { transform: translateX(96%) rotateY(-14deg) scale(.88); }
  }
  :global([data-theme='light']) .jd-stage-side { opacity: .7; }

  /* 무대 아래 — 새 글 소개. 애플 제품 이름처럼 가운데에 크게 */
  .jd-stage-cap { max-width: 760px; margin: 56px auto 0; text-align: center; }
  .jd-stage-title { margin: 0; font-size: clamp(34px, 4vw, 56px); line-height: 1.08; font-weight: 700; letter-spacing: -.03em; text-wrap: balance; }
  .jd-stage-title a { color: var(--jd-text); }
  .jd-stage-title a:hover { text-decoration: none; color: var(--jd-link); }
  .jd-stage-sub { margin: 14px 0 0; font-size: clamp(20px, 2vw, 26px); line-height: 1.3; font-weight: 600; letter-spacing: -.02em; color: var(--jd-text-2); }
  .jd-stage-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; max-width: 620px; margin: 20px auto 0; font-size: 17px; line-height: 1.6; color: var(--jd-body); }
  .jd-stage-meta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 6px 16px; margin: 22px 0 0; font-size: 14px; color: var(--jd-text-3); }
  .jd-stage-new { font-weight: 600; color: var(--jd-new); }
  .jd-stage-meta a { display: inline-flex; align-items: center; gap: 7px; color: var(--jd-text-2); }
  .jd-stage-meta i { width: 7px; height: 7px; border-radius: 50%; background: var(--jd-acc); }
  .jd-stage-go { margin-top: 28px; }

  @media (max-width: 1060px) {
    .jd-stage-side { width: 34%; }
    .jd-stage-side.is-l { transform: translateX(-74%) rotateY(22deg) scale(.8); }
    .jd-stage-side.is-r { transform: translateX(74%) rotateY(-22deg) scale(.8); }
  }
  @media (max-width: 760px) {
    .jd-hero { padding: 64px 0 84px; }
    .jd-stage { margin-top: 56px; }
    .jd-stage-art { min-height: 0; }
    .jd-stage-art > .jd-stage-side { display: none; } /* .jd-stage-art > * 의 display 보다 구체적으로 */
    .jd-stage-back { width: 80%; margin-bottom: 96px; }
    .jd-stage-back + .jd-stage-front { width: 90%; margin-top: 72px; }
    .jd-stage-cap { margin-top: 40px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .jd-hero-text > * { animation: jdHeroIn 1.1s var(--jd-ease-out) both; }
    .jd-hero-text > :nth-child(2) { animation-delay: .08s; }
    .jd-hero-text > :nth-child(3) { animation-delay: .16s; }
    /* 무대 — 가운데 창이 먼저 떠오르고, 양옆 창은 가운데 뒤에서 펼쳐져 나온다 */
    .jd-stage-main { animation: jdHeroIn 1.2s var(--jd-ease-out) .22s both; }
    /* backwards — 끝난 뒤에는 원래 transform 으로 돌아가 hover 가 듣는다 */
    .jd-stage-side.is-l { animation: jdFanL 1.4s var(--jd-ease-out) .42s backwards; }
    .jd-stage-side.is-r { animation: jdFanR 1.4s var(--jd-ease-out) .42s backwards; }
    .jd-stage-cap { animation: jdHeroIn 1.1s var(--jd-ease-out) .5s both; }
    /* 스크롤로 화면 위로 빠져나갈 때 글자 쪽이 살짝 작아지며 흐려진다 — 등장 애니메이션과 겹치지 않게 부모에 건다.
       animation 단축 속성을 쓰면 CSS 압축 때 animation-timeline 까지 한 줄로 합쳐져 브라우저가 버리므로 개별 속성으로 쓴다 */
    @supports (animation-timeline: view()) {
      .jd-hero-text {
        animation-name: jdHeroOut; animation-timing-function: linear; animation-fill-mode: both;
        animation-timeline: view(); animation-range: exit 10% exit 100%;
      }
    }
  }
  @keyframes jdHeroOut { to { opacity: 0; transform: scale(.92); } }
  @keyframes jdFanL { from { opacity: 0; transform: translateX(-20%) rotateY(0) scale(.7); } }
  @keyframes jdFanR { from { opacity: 0; transform: translateX(20%) rotateY(0) scale(.7); } }
</style>

<script>
  // 스크롤로 빠져나가는 효과의 대체 동작 — animation-timeline 이 없는 브라우저(Firefox 등)만.
  // CSS 의 view() exit 10%~100% 와 같은 곡선: 기준선은 화면 위가 아니라 scroll-padding-top(고정 메뉴 아래)
  const hero = document.querySelector<HTMLElement>('.jd-hero-text');
  if (hero && !CSS.supports('animation-timeline: view()') && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    let start = 0, span = 1, queued = false;
    const measure = () => {
      hero.style.transform = '';
      const r = hero.getBoundingClientRect();
      const inset = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      start = r.top + scrollY - inset + r.height * 0.1;
      span = r.height * 0.9;
    };
    const update = () => {
      queued = false;
      const p = Math.min(1, Math.max(0, (scrollY - start) / span));
      hero.style.opacity = String(1 - p);
      hero.style.transform = p ? `scale(${1 - 0.08 * p})` : '';
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', () => { measure(); update(); });
    measure();
    update();
  }
</script>
