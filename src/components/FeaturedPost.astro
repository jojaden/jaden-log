---
import MacWindow from './MacWindow.astro';
import { type Post, postHref, postLang, splitTitle, nbHyphen, formatDate, extractCover } from '../lib/posts';
import { catOf, subLabel } from '../lib/site';
import { ui } from '../lib/i18n';
interface Props { post: Post }
const { post } = Astro.props;
const lang = postLang(post);
const t = ui(lang);
const { title, category, subcategory, pubDate, description } = post.data;
const { main, sub } = splitTitle(title);
const cat = catOf(category);
const cover = extractCover(post.body);
const href = postHref(post);
---
<article class="jd-feat jd-rise" style={cat ? `--jd-tint:${cat.tint};--jd-acc:${cat.acc}` : undefined}>
  <div class="jd-feat-text">
    <p class="jd-feat-eyebrow">{t.newPost} · {category}</p>
    <h2 class="jd-feat-title">
      <a href={href}>{nbHyphen(main)}{sub && <span class="jd-feat-sub">{sub}</span>}</a>
    </h2>
    {description && <p class="jd-feat-desc">{description}</p>}
    <p class="jd-feat-meta"><a class="jd-more" href={href} tabindex="-1" aria-hidden="true">{t.read}</a><time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time></p>
  </div>
  <a class="jd-feat-visual" href={href} tabindex="-1" aria-hidden="true">
    {cover ? (
      <span class="jd-feat-stack">
        {cover.back && <span class="jd-feat-back"><MacWindow win={cover.back} /></span>}
        <span class="jd-feat-front"><MacWindow win={cover.front} /></span>
      </span>
    ) : <span class="jd-feat-cat">{subLabel(category, subcategory, lang)}</span>}
  </a>
</article>
<style>
  .jd-feat {
    display: flex; flex-wrap: wrap; align-items: stretch; overflow: hidden; border-radius: var(--jd-r-lg);
    background: var(--jd-glass); border: 1px solid var(--jd-glass-line); box-shadow: var(--jd-glass-hi);
    -webkit-backdrop-filter: var(--jd-blur); backdrop-filter: var(--jd-blur);
    transition: transform .6s var(--jd-spring), border-color .6s, background .6s;
  }
  .jd-feat:hover { border-color: var(--jd-glass-line-2); background: var(--jd-glass-2); }
  @media (prefers-reduced-motion: no-preference) { .jd-feat:active { transform: scale(.99) !important; transition-duration: .15s; } } /* 누름 — 큰 카드라 덜 줄인다 */
  .jd-feat-text { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 72px 64px; }
  .jd-feat-eyebrow { margin: 0 0 18px; font-size: 17px; font-weight: 600; color: var(--jd-new); }
  .jd-feat-title { margin: 0 0 18px; font-size: clamp(34px, 3.6vw, 52px); line-height: 1.08; font-weight: 700; letter-spacing: -.025em; }
  .jd-feat-title a { color: var(--jd-text); }
  .jd-feat-title a:hover { text-decoration: none; }
  .jd-feat-sub { display: block; margin-top: 14px; font-size: clamp(20px, 1.8vw, 24px); line-height: 1.3; font-weight: 600; letter-spacing: -.015em; color: var(--jd-text-2); }
  .jd-feat-desc { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin: 0 0 18px; font-size: 17px; line-height: 1.6; color: #D2D2D7; }
  .jd-feat-meta { display: flex; align-items: baseline; gap: 14px; margin: 0; font-size: 14px; color: var(--jd-text-3); }
  /* 창 뒤에 카테고리 색 빛 번짐 */
  .jd-feat-visual {
    flex: 1 1 440px; min-width: 0; display: flex; align-items: center; justify-content: center; min-height: 340px; padding: 56px;
    background: radial-gradient(closest-side at 55% 50%, color-mix(in srgb, var(--jd-acc, #2997FF) 30%, transparent), transparent);
  }
  .jd-feat-visual:hover { text-decoration: none; }
  /* 코드 창 앞, 실행 결과 창 뒤 — 같은 칸에 겹쳐 놓고 서로 반대 모서리로 비켜 둔다 */
  .jd-feat-stack { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; max-width: 540px; }
  /* min-width: 0 — 긴 코드 줄이 칸을 넓혀 카드 밖으로 넘치지 않게 */
  .jd-feat-stack > * { grid-area: 1 / 1; display: flex; min-width: 0; }
  /* 앞 창은 불투명하게 — 뒤 창 글자가 비치지 않게 */
  .jd-feat-back + .jd-feat-front :global(.jd-win) { background: #111114; }
  .jd-feat-back { justify-self: end; align-self: start; width: 78%; margin-bottom: 120px; opacity: .78; }
  .jd-feat-back + .jd-feat-front { justify-self: start; align-self: end; width: 86%; margin-top: 96px; }
  .jd-feat-front { z-index: 1; }
  .jd-feat-cat { font-size: clamp(40px, 4.4vw, 64px); line-height: 1.06; font-weight: 700; letter-spacing: -.025em; color: rgba(245, 245, 247, .9); }
  @media (max-width: 760px) {
    .jd-feat-text { padding: 32px 26px; }
    .jd-feat-visual { min-height: 0; padding: 0 20px 24px; }
  }
</style>
