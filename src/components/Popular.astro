---
/**
 * 많이 읽은 글 — 순위는 방문 수 카운터(worker/index.ts 의 /api/popular)에서 받는다.
 * 이 언어판의 글을 모두 숨긴 채로 넣어 두고, 받은 순서대로 열 개까지 보인다. 세 개가 안 되거나 받지 못하면 섹션째 숨긴 채로 둔다.
 * 기간 탭(이번 주·이번 달·전체) — 그 기간에 읽힌 글이 세 편 이상 쌓인 탭만 보이고, 보이는 탭 중 앞의 것을 먼저 고른다. 전체 말고 보일 탭이 없으면 탭 없이 둔다.
 * 보는 사람의 나라 순위가 오면 전체 탭의 부제를 '그 나라에서 많이 읽힌 글'로 바꾼다
 */
import { getPosts, postHref, formatDate } from '../lib/posts';
import { catOf, subLabel } from '../lib/site';
import { langOf, ui } from '../lib/i18n';
const lang = langOf(Astro.url);
const t = ui(lang);
const posts = await getPosts(lang);
---
<section class="jd-popular" aria-labelledby="jd-popular-title" data-locale={t.htmlLang} data-in={t.popularIn} data-week={t.popularWeek} data-month={t.popularMonth} data-all={t.popularSub} hidden>
  <div class="jd-sec-head">
    <h2 class="jd-sec-title" id="jd-popular-title">{t.popular}<span>{t.popularSub}</span></h2>
    <div class="jd-popular-tabs" role="group" aria-label={t.popularRange} hidden>
      {(['week', 'month', 'all'] as const).map((k) => <button type="button" data-range={k} aria-pressed="false" hidden>{t.popularTabs[k]}</button>)}
    </div>
  </div>
  <ol class="jd-popular-list">
    {posts.map((p) => (
      <li data-id={p.id} hidden style={`--jd-acc:${catOf(p.data.category)?.acc ?? 'var(--jd-text-3)'}`}>
        {/* 긴 제목은 한 줄로 — 마우스를 올리면 흐른다 (.jd-pan, global.css). 흐르지 않는 환경에서는 두 줄로 접는다 */}
        <a class="jd-pan-host" href={postHref(p)}>
          <strong><span class="jd-pan"><span class="jd-pan-in">{p.data.title}</span></span></strong>
          <span class="jd-popular-meta"><i aria-hidden="true"></i>{p.data.category} · {subLabel(p.data.category, p.data.subcategory, lang)}<time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate, lang)}</time></span>
        </a>
      </li>
    ))}
  </ol>
</section>

<script>
  const box = document.querySelector<HTMLElement>('.jd-popular');
  const list = box?.querySelector('ol');
  if (box && list) {
    fetch('/api/popular')
      .then((r) => (r.ok ? r.json() : { cc: null, ids: [] }))
      .then(({ cc, ids, week = [], month = [] }: { cc: string | null; ids: string[]; week?: string[]; month?: string[] }) => {
        // 이 언어판에 있는 글만, 받은 순서대로 열 개까지
        const pick = (order: string[]) => order.map((id) => list.querySelector<HTMLLIElement>(`li[data-id="${CSS.escape(id)}"]`)).filter((li): li is HTMLLIElement => !!li).slice(0, 10);
        const ranks: Record<string, HTMLLIElement[]> = { week: pick(week), month: pick(month), all: pick(ids) };
        if (ranks.all.length < 3) return;
        const subs: Record<string, string> = { week: box.dataset.week!, month: box.dataset.month!, all: box.dataset.all! };
        if (cc) {
          const locale = box.dataset.locale!;
          let name = new Intl.DisplayNames([locale], { type: 'region' }).of(cc) ?? cc;
          // 영어에서 the 를 붙여 부르는 나라 이름 — the United States, the Philippines, the Cayman Islands …
          if (locale === 'en' && /^(United |Netherlands$|Philippines$|Bahamas$|Gambia$|Maldives$)|(Islands|Republic)$/.test(name)) name = `the ${name}`;
          subs.all = box.dataset.in!.replace('{c}', name);
        }
        const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-range]')].filter((b) => ranks[b.dataset.range!].length >= 3);
        const show = (range: string) => {
          list.querySelectorAll('li').forEach((li) => { li.hidden = true; });
          ranks[range].forEach((li) => { li.hidden = false; list.append(li); }); // 받은 순서대로 뒤에 다시 붙여 순위 순으로 놓는다
          box.querySelector('h2 span')!.textContent = subs[range];
          tabs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.range === range)));
        };
        if (tabs.length > 1) {
          tabs.forEach((b) => { b.hidden = false; b.addEventListener('click', () => show(b.dataset.range!)); });
          box.querySelector<HTMLElement>('.jd-popular-tabs')!.hidden = false;
        }
        show(tabs[0].dataset.range!);
        box.hidden = false;
      })
      .catch(() => {});
  }
</script>

<style>
  .jd-popular { margin: 128px 0 0; } /* 홈 바탕 띠 안, '주제별로 보기' 바로 아래 */
  .jd-popular[hidden] { display: none; }
  /* 기간 탭 — 알약 모양 세그먼트. 칸 폭을 같게 둬 고른 탭이 굵어져도 흔들리지 않는다 */
  .jd-popular-tabs { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 4px; padding: 4px; border-radius: 980px; background: var(--jd-fill-2); }
  .jd-popular-tabs[hidden], .jd-popular-tabs button[hidden] { display: none; }
  .jd-popular-tabs button { min-height: 36px; padding: 0 18px; border: 0; border-radius: 980px; background: none; cursor: pointer; font: 500 14px var(--jd-font); color: var(--jd-text-2); white-space: nowrap; transition: background .2s, color .2s; }
  .jd-popular-tabs button:hover { color: var(--jd-text); }
  .jd-popular-tabs button[aria-pressed='true'] { background: var(--jd-canvas); color: var(--jd-text); font-weight: 600; box-shadow: 0 1px 3px var(--jd-shadow); }
  .jd-popular-list { margin: 0; padding: 0; list-style: none; counter-reset: rank; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; }
  .jd-popular-list li { counter-increment: rank; border-top: 1px solid var(--jd-line); }
  .jd-popular-list li[hidden] { display: none; }
  .jd-popular-list a { display: grid; grid-template-columns: 44px 1fr; align-items: baseline; padding: 14px 0; color: inherit; }
  .jd-popular-list a::before { content: counter(rank); font: 600 23px/1 var(--jd-logo); letter-spacing: -.02em; color: var(--jd-text-3); transition: color .2s; } /* 순위 — 로고 글꼴 숫자. 마우스를 올리면 그 글의 주제 색 */
  .jd-popular-list a:hover::before { color: var(--jd-acc); }
  .jd-popular-list a:hover { text-decoration: none; }
  .jd-popular-list strong { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; font-size: 16px; line-height: 1.45; font-weight: 600; color: var(--jd-text); transition: color .2s; }
  .jd-popular-list a:hover strong { color: var(--jd-link); }
  .jd-popular-meta { grid-column: 2; display: flex; align-items: center; gap: 7px; margin-top: 4px; font-size: 12.5px; color: var(--jd-text-3); }
  .jd-popular-meta i { width: 7px; height: 7px; border-radius: 50%; background: var(--jd-acc); }
  .jd-popular-meta time::before { content: '·'; margin: 0 6px 0 2px; }
  @media (max-width: 760px) {
    .jd-popular { margin-top: 84px; }
    .jd-popular-tabs button { min-height: 40px; }
    .jd-popular-list { grid-template-columns: 1fr; }
    .jd-popular-list a { grid-template-columns: 36px 1fr; padding: 12px 0; }
    .jd-popular-list a::before { font-size: 19px; }
    .jd-popular-list strong { font-size: 15.5px; }
  }
</style>
