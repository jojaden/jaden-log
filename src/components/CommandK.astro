---
/**
 * 검색 창(⌘K) — 어느 페이지에서나 ⌘K·Ctrl+K·/ 로 열거나, 상단 메뉴의 검색칸·검색 단추를 누르면 열린다.
 * 비어 있을 때는 최근 글, 글자를 치면 Pagefind 결과. ↑↓ 로 고르고 Enter 로 연다. JS 가 없으면 메뉴의 검색은 /search 로 간다
 */
import { getPosts, postHref, formatDate } from '../lib/posts';
import { subLabel } from '../lib/site';
import { langOf, localize, ui } from '../lib/i18n';
const lang = langOf(Astro.url);
const t = ui(lang);
const recent = (await getPosts(lang)).slice(0, 5);
---
<dialog class="jd-cmdk" id="jd-cmdk" aria-label={t.search} closedby="any" data-search={localize('/search', lang)} data-none={t.searchNone} data-dev={t.searchDev}>
  <div class="jd-cmdk-in">
    <div class="jd-cmdk-field">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color: var(--jd-text-3)" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 21 21"></path></svg>
      <input type="search" placeholder={t.searchPlaceholder} aria-label={t.searchQuery} autocomplete="off" spellcheck="false"
        role="combobox" aria-expanded="true" aria-controls="jd-cmdk-list" aria-autocomplete="list" />
      <kbd class="jd-cmdk-esc">esc</kbd>
    </div>
    <p class="jd-cmdk-label" id="jd-cmdk-label">{t.recent}</p>
    <ul class="jd-cmdk-list" id="jd-cmdk-list" role="listbox" aria-labelledby="jd-cmdk-label">
      {recent.map((p, i) => (
        <li role="option" id={`jd-cmdk-o${i}`} aria-selected={i === 0 ? 'true' : 'false'}>
          <a href={postHref(p)} tabindex="-1"><strong>{p.data.title}</strong><small>{p.data.category} · {subLabel(p.data.category, p.data.subcategory, lang)} · {formatDate(p.data.pubDate, lang)}</small></a>
        </li>
      ))}
    </ul>
    <p class="jd-cmdk-status" aria-live="polite"></p>
    <div class="jd-cmdk-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> {t.cmdkMove}</span><span><kbd>↵</kbd> {t.cmdkOpen}</span>
      <a class="jd-cmdk-all" href={localize('/search', lang)}>{t.cmdkAll}</a>
    </div>
  </div>
</dialog>

<script>
  import { search, esc } from '../lib/search';
  const dlg = document.getElementById('jd-cmdk') as HTMLDialogElement;
  const input = dlg.querySelector('input')!;
  const list = dlg.querySelector<HTMLUListElement>('.jd-cmdk-list')!;
  const label = dlg.querySelector<HTMLElement>('.jd-cmdk-label')!;
  const status = dlg.querySelector<HTMLElement>('.jd-cmdk-status')!;
  const all = dlg.querySelector<HTMLAnchorElement>('.jd-cmdk-all')!;
  const recentHTML = list.innerHTML;
  const recentLabel = label.textContent;
  let active = 0;

  const options = () => [...list.querySelectorAll<HTMLLIElement>('[role="option"]')];
  function select(i: number) {
    const opts = options();
    if (!opts.length) { input.removeAttribute('aria-activedescendant'); return; }
    active = (i + opts.length) % opts.length;
    opts.forEach((o, k) => o.setAttribute('aria-selected', String(k === active)));
    input.setAttribute('aria-activedescendant', opts[active].id);
    opts[active].scrollIntoView({ block: 'nearest' });
  }

  function open() {
    if (dlg.open) return;
    dlg.showModal();
    input.focus();
    input.select();
    select(0);
  }
  // 열기 — ⌘K·Ctrl+K 어디서나, / 는 글자를 치는 중이 아닐 때
  // K 는 글자(key)와 자리(code)를 함께 본다 — Caps Lock 이면 'K', 한글 자판이면 'ㅏ' 로 들어온다
  document.addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea, [contenteditable]');
    const k = e.key.toLowerCase() === 'k' || e.code === 'KeyK';
    if ((k && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey && !e.altKey)) {
      e.preventDefault();
      open();
    }
  });
  // 상단 메뉴의 검색칸·검색 단추 — 자리에서 바로 검색 창을 연다
  document.querySelectorAll<HTMLElement>('[data-cmdk-open]').forEach((el) => {
    el.addEventListener('click', (e) => { e.preventDefault(); open(); });
    if (el instanceof HTMLInputElement) el.addEventListener('focus', () => { el.blur(); open(); });
  });
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); }); // 창 밖 — closedby 를 모르는 브라우저용
  // 단축키 안내는 맥이면 ⌘K, 아니면 Ctrl K
  if (!/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelectorAll('.jd-gnav-kbd').forEach((k) => (k.textContent = 'Ctrl K'));

  let seq = 0;
  let timer: number | undefined;
  async function run(q: string) {
    const my = ++seq;
    all.href = q ? `${dlg.dataset.search}?q=${encodeURIComponent(q)}` : dlg.dataset.search!;
    if (!q.trim()) { list.innerHTML = recentHTML; label.textContent = recentLabel; label.hidden = false; status.textContent = ''; select(0); return; }
    const hits = await search(q, 8);
    if (my !== seq) return;
    label.hidden = true;
    if (!hits) { list.innerHTML = ''; status.textContent = dlg.dataset.dev!; return; }
    status.textContent = hits.length ? '' : dlg.dataset.none!;
    list.innerHTML = hits.map((h, i) => `<li role="option" id="jd-cmdk-o${i}" aria-selected="false"><a href="${esc(h.url)}" tabindex="-1"><strong>${esc(h.title)}</strong>${h.meta ? `<small>${esc(h.meta)}</small>` : ''}<span>${h.excerpt}</span></a></li>`).join('');
    select(0);
  }
  input.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(() => run(input.value), 140); });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); select(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); select(active - 1); }
    else if (e.key === 'Enter' && !e.isComposing) {
      e.preventDefault();
      const a = options()[active]?.querySelector('a');
      if (a) location.href = a.href; else if (input.value.trim()) location.href = all.href;
    }
  });
  list.addEventListener('mousemove', (e) => {
    const o = (e.target as HTMLElement).closest<HTMLLIElement>('[role="option"]');
    if (o) { const i = options().indexOf(o); if (i !== active) select(i); }
  });
</script>

<style>
  .jd-cmdk {
    position: fixed; inset: min(14vh, 120px) 0 auto; margin: 0 auto; padding: 0;
    width: min(640px, calc(100% - 24px)); max-width: none; max-height: min(70dvh, 620px);
    border: 1px solid var(--jd-glass-line); border-radius: 20px;
    background: var(--jd-sheet); -webkit-backdrop-filter: blur(30px) saturate(170%); backdrop-filter: blur(30px) saturate(170%);
    box-shadow: var(--jd-glass-hi), 0 30px 80px -24px var(--jd-shadow);
    color: var(--jd-body); overflow: hidden;
  }
  .jd-cmdk::backdrop { background: rgba(0, 0, 0, .5); }
  .jd-cmdk-in { display: flex; flex-direction: column; max-height: inherit; }
  .jd-cmdk-field { position: relative; display: flex; align-items: center; gap: 12px; padding: 0 16px 0 20px; border-bottom: 1px solid var(--jd-line); }
  .jd-cmdk-field input {
    flex: 1; min-width: 0; height: 60px; padding: 0; border: 0; outline: none; background: none;
    color: var(--jd-text); font: 18px var(--jd-font); -webkit-appearance: none; appearance: none;
  }
  .jd-cmdk-field input::-webkit-search-cancel-button { display: none; }
  .jd-cmdk-field input::placeholder { color: var(--jd-text-3); }
  .jd-cmdk kbd {
    display: inline-flex; align-items: center; justify-content: center; min-width: 22px; height: 22px; padding: 0 6px; border-radius: 6px;
    background: var(--jd-fill-2); border: 1px solid var(--jd-glass-line); font: 600 11.5px var(--jd-font); color: var(--jd-text-2);
  }
  .jd-cmdk-label { margin: 0; padding: 14px 20px 6px; font-size: 12.5px; font-weight: 600; letter-spacing: .02em; color: var(--jd-text-3); }
  .jd-cmdk-label[hidden] { display: none; }
  .jd-cmdk-list { flex: 1; overflow-y: auto; overscroll-behavior: contain; margin: 0; padding: 6px 8px 8px; list-style: none; }
  .jd-cmdk-list :global(a) { display: block; padding: 11px 12px; border-radius: 12px; color: inherit; }
  .jd-cmdk-list :global(a:hover) { text-decoration: none; }
  .jd-cmdk-list :global([aria-selected='true'] a) { background: rgba(41, 151, 255, .16); }
  .jd-cmdk-list :global(strong) { display: block; font-size: 15.5px; font-weight: 600; line-height: 1.4; color: var(--jd-text); }
  .jd-cmdk-list :global(small) { display: block; margin-top: 2px; font-size: 12.5px; color: var(--jd-text-3); }
  .jd-cmdk-list :global(span) { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 1; overflow: hidden; margin-top: 4px; font-size: 13.5px; color: var(--jd-text-2); }
  .jd-cmdk-list :global(mark) { background: rgba(41, 151, 255, .25); color: var(--jd-text); border-radius: 3px; padding: 0 2px; }
  .jd-cmdk-status { margin: 0; padding: 0 20px; font-size: 14px; color: var(--jd-text-3); }
  .jd-cmdk-status:not(:empty) { padding: 18px 20px; }
  .jd-cmdk-foot { display: flex; align-items: center; gap: 16px; padding: 10px 16px 10px 20px; border-top: 1px solid var(--jd-line); font-size: 12.5px; color: var(--jd-text-3); }
  .jd-cmdk-foot span { display: inline-flex; align-items: center; gap: 4px; }
  .jd-cmdk-all { margin-left: auto; display: inline-flex; align-items: center; min-height: 36px; font-size: 13.5px; }
  @media (hover: none) { .jd-cmdk-foot span, .jd-cmdk-esc { display: none; } } /* 터치 기기에는 키보드 안내를 숨긴다 */
  @media (max-width: 760px) { .jd-cmdk { inset: 12px 0 auto; max-height: min(80dvh, 620px); } }
  @media (prefers-reduced-motion: no-preference) {
    .jd-cmdk[open] { transition: transform .45s var(--jd-spring), opacity .2s; }
    @starting-style { .jd-cmdk[open] { transform: translateY(-12px) scale(.98); opacity: 0; } }
  }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .jd-cmdk { background: var(--jd-solid); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
</style>
