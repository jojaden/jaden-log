---
import { getPosts, countBy, postHref } from '../lib/posts';
import { SITE, CATEGORIES, catHref, tagHref, subLabel, siteText } from '../lib/site';
import { langOf, localize, ui } from '../lib/i18n';
const lang = langOf(Astro.url);
const t = ui(lang);
const posts = await getPosts(lang);
const c = countBy(posts);
const tags = [...c.tags.entries()].sort((a, b) => b[1] - a[1]).slice(0, 24);
const recent = posts.slice(0, 5);
---
<div class="jd-drawer" id="jd-drawer" hidden>
  <div class="jd-drawer-dim" data-drawer-close></div>
  <aside class="jd-drawer-panel" role="dialog" aria-modal="true" aria-label={t.drawer}>
    <div class="jd-drawer-top">
      <a class="jd-drawer-logo" href={localize('/', lang)}><img src="/avatar.webp" alt="" width="32" height="32" />{SITE.title}</a>
      <button type="button" class="jd-drawer-x" data-drawer-close aria-label={t.menuClose}>
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="#F5F5F7" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
    </div>
    <p class="jd-drawer-slogan">{siteText(lang).slogan}</p>

    <section class="jd-box">
      <h2>{t.categories}</h2>
      <a class="jd-tree-all" href={localize('/category', lang)}>{t.allPostsTree} <em>{c.total}</em></a>
      <ul class="jd-tree">
        {CATEGORIES.map((cat) => (
          <li>
            <a class="jd-tree-top" href={catHref(cat.name, undefined, lang)}>
              <i style={`background:${cat.acc}`}></i>{cat.name} <em>{c.top.get(cat.name) ?? 0}</em>
            </a>
            <ul>
              {cat.subs.map((s) => (
                <li><a href={catHref(cat.name, s, lang)}>{subLabel(cat.name, s, lang)} <em>{c.sub.get(`${cat.name}/${s}`) ?? 0}</em></a></li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section class="jd-box">
      <h2>{t.recent}</h2>
      <ul class="jd-recent">
        {recent.map((p) => <li><a class="jd-pan-host" href={postHref(p)}><span class="jd-pan"><span class="jd-pan-in">{p.data.title}</span></span></a></li>)}
      </ul>
    </section>

    {tags.length > 0 && (
      <section class="jd-box">
        <h2>{t.tags}</h2>
        <div class="jd-tags">
          {tags.map(([tag]) => <a href={tagHref(tag, lang)}>{tag}</a>)}
        </div>
      </section>
    )}

    {/* 방문 수 — 아래 스크립트가 /api/views(worker/index.ts)에서 받아 채운다. 받지 못하면(개발 서버 등) 숨긴 채로 둔다 */}
    <section class="jd-box jd-visits" data-locale={t.htmlLang} hidden>
      <h2>{t.visits}</h2>
      <dl>
        <div data-post-only hidden><dt>{t.visitPost}</dt><dd data-v="post">-</dd></div>
        <div><dt>{t.visitToday}</dt><dd data-v="today">-</dd></div>
        <div><dt>{t.visitYesterday}</dt><dd data-v="yesterday">-</dd></div>
        <div><dt>{t.visitTotal}</dt><dd data-v="total">-</dd></div>
      </dl>
      <ol class="jd-countries" aria-label={t.visitCountries} data-other={t.visitOther} data-rank={t.visitRank} hidden></ol>
    </section>

    <div class="jd-drawer-links">
      <a href={SITE.github} rel="me noopener">GitHub</a>
      <a href={localize('/rss.xml', lang)}>RSS</a>
    </div>
  </aside>
</div>

<script>
  const root = document.getElementById('jd-drawer')!;
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-drawer-open]');
  let last: Element | null = null;
  function open() {
    last = document.activeElement;
    root.hidden = false;
    requestAnimationFrame(() => root.classList.add('is-open'));
    document.documentElement.style.overflow = 'hidden';
    openers.forEach((b) => b.setAttribute('aria-expanded', 'true'));
    root.querySelector<HTMLElement>('.jd-drawer-x')?.focus();
  }
  function close() {
    root.classList.remove('is-open');
    document.documentElement.style.overflow = '';
    openers.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    setTimeout(() => (root.hidden = true), 300);
    (last as HTMLElement | null)?.focus?.();
  }
  openers.forEach((b) => b.addEventListener('click', open));
  root.querySelectorAll('[data-drawer-close]').forEach((b) => b.addEventListener('click', close));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !root.hidden) close(); });

  // 방문 수 — 같은 브라우저는 하루(한국 시간)에 사이트 방문 한 번, 글마다 조회 한 번만 센다(POST), 그 뒤로는 읽기만(GET). 봇은 세지 않는다
  // 글 화면이면 글 번호(article 의 data-post)를 함께 보내 그 글의 조회수도 받는다
  const box = root.querySelector<HTMLElement>('.jd-visits')!;
  const today = new Date(Date.now() + 9 * 3600_000).toISOString().slice(0, 10);
  const post = document.querySelector<HTMLElement>('.jd-post[data-post]')?.dataset.post;
  const keys = { site: 'jd-visit', post: `jd-visit:${post}` };
  const bot = navigator.webdriver || /bot|crawl|spider|slurp|preview/i.test(navigator.userAgent);
  const seen = (k: keyof typeof keys) => { try { return localStorage.getItem(keys[k]) === today; } catch { return false; } };
  const kinds: (keyof typeof keys)[] = post ? ['site', 'post'] : ['site'];
  const hit = bot ? [] : kinds.filter((k) => !seen(k));
  const q = new URLSearchParams();
  if (post) q.set('post', post);
  if (hit.length) q.set('hit', hit.join(','));
  fetch(`/api/views?${q}`, { method: hit.length ? 'POST' : 'GET' })
    .then((r) => (r.ok ? r.json() : null))
    .then((v: { total: number; today: number; yesterday: number; post?: number; countries?: { cc: string; n: number; rank?: number }[] } | null) => {
      if (!v) return;
      try { hit.forEach((k) => localStorage.setItem(keys[k], today)); } catch {}
      const fmt = new Intl.NumberFormat(box.dataset.locale);
      box.querySelectorAll<HTMLElement>('[data-v]').forEach((el) => { el.textContent = fmt.format(v[el.dataset.v as 'total'] ?? 0); });
      if (v.post !== undefined) box.querySelector<HTMLElement>('[data-post-only]')!.hidden = false;
      // 전체 수의 나라별 몫 — 국기는 나라 코드 두 글자를 지역 표시 문자로 바꿔 만든다. 상위 몇 개 밖은 '기타'로 묶고,
      // 상위 밖인데 따로 온 나라(rank 있음, worker 의 HOME_COUNTRY)는 순위를 붙인다. 순위 문구의 {n} 자리에 숫자가 들어간다
      const list = box.querySelector<HTMLOListElement>('.jd-countries')!;
      const countries = v.countries ?? [];
      if (countries.length && v.total) {
        const names = new Intl.DisplayNames([box.dataset.locale!], { type: 'region' });
        const flag = (cc: string) => String.fromCodePoint(...[...cc].map((c) => 0x1f1a5 + c.charCodeAt(0)));
        const rows = countries.map((c) => ({ label: `${flag(c.cc)} ${names.of(c.cc) ?? c.cc}${c.rank ? ` · ${list.dataset.rank!.replace('{n}', String(c.rank))}` : ''}`, n: c.n }));
        const other = v.total - countries.reduce((s, c) => s + c.n, 0);
        if (other > 0) rows.push({ label: list.dataset.other!, n: other });
        list.replaceChildren(...rows.map((r) => {
          const li = document.createElement('li');
          li.style.setProperty('--w', `${(r.n / v.total) * 100}%`);
          const name = document.createElement('span');
          const num = document.createElement('b');
          name.textContent = r.label;
          num.textContent = fmt.format(r.n);
          li.append(name, num);
          return li;
        }));
        list.hidden = false;
      }
      box.hidden = false;
    })
    .catch(() => {});
</script>

<style>
  .jd-drawer { position: fixed; inset: 0; z-index: 200; }
  .jd-drawer-dim { position: absolute; inset: 0; background: rgba(0, 0, 0, .55); opacity: 0; transition: opacity .3s; }
  .jd-drawer-panel {
    position: absolute; top: 0; right: 0; bottom: 0; width: min(381px, 100%);
    overflow-y: auto; padding: 22px 24px 40px;
    background: rgba(22, 22, 24, .78); border-left: 1px solid var(--jd-glass-line);
    -webkit-backdrop-filter: blur(30px) saturate(170%); backdrop-filter: blur(30px) saturate(170%);
    transform: translateX(100%); transition: transform .35s var(--jd-ease-out);
  }
  .jd-drawer.is-open .jd-drawer-dim { opacity: 1; }
  .jd-drawer.is-open .jd-drawer-panel { transform: none; }
  @media (prefers-reduced-motion: reduce) { .jd-drawer-panel, .jd-drawer-dim { transition: none; } }

  .jd-drawer-top { display: flex; align-items: center; justify-content: space-between; }
  .jd-drawer-logo { display: inline-flex; align-items: center; gap: 10px; font: 600 18px var(--jd-logo); color: var(--jd-text); letter-spacing: -.03em; }
  .jd-drawer-logo img { border-radius: 50%; }
  .jd-drawer-logo:hover { text-decoration: none; }
  .jd-drawer-x { width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(255, 255, 255, .08); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .jd-drawer-slogan { margin: 8px 0 22px; font-size: 14px; color: var(--jd-text-3); }

  .jd-box { margin: 0 0 14px; padding: 18px 20px; border-radius: 20px; background: rgba(255, 255, 255, .05); border: 1px solid rgba(255, 255, 255, .08); }
  .jd-box h2 { margin: 0 0 12px; font-size: 13px; font-weight: 600; letter-spacing: .02em; color: var(--jd-text-3); }
  .jd-box ul { margin: 0; padding: 0; list-style: none; }
  .jd-box a { color: var(--jd-body); font-size: 15px; }
  .jd-box a:hover { color: var(--jd-text); text-decoration: none; }
  .jd-box em { font-style: normal; color: var(--jd-text-3); font-size: 13px; margin-left: 2px; }

  .jd-tree-all { display: block; padding: 6px 0 10px; font-weight: 600; }
  .jd-tree > li { padding: 8px 0; border-top: 1px solid rgba(255, 255, 255, .06); }
  .jd-tree-top { display: flex; align-items: center; gap: 10px; font-weight: 600; color: var(--jd-text) !important; }
  .jd-tree-top i { width: 8px; height: 8px; border-radius: 50%; }
  .jd-tree ul { padding: 4px 0 0 18px !important; }
  .jd-tree ul a { display: block; padding: 4px 0; font-size: 14px; color: var(--jd-text-2); }

  .jd-recent li { padding: 9px 0; }
  .jd-recent li + li { border-top: 1px solid rgba(255, 255, 255, .06); }
  .jd-recent a { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 14px; line-height: 1.45; }

  .jd-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .jd-tags a { padding: 4px 10px; border-radius: 980px; background: rgba(255, 255, 255, .07); font-size: 13px; }

  .jd-visits dl { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 8px; margin: 0; }
  .jd-visits dt { font-size: 12.5px; color: var(--jd-text-3); }
  .jd-visits dd { margin: 2px 0 0; font-size: 19px; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: -.01em; color: var(--jd-text); }
  .jd-countries { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 4px; }
  /* 나라 줄은 스크립트가 만들어 범위 스타일 표시가 없다 — :global 로 잡는다 */
  .jd-countries :global(li) { position: relative; display: flex; justify-content: space-between; gap: 12px; padding: 5px 8px; border-radius: 8px; font-size: 13.5px; overflow: hidden; }
  .jd-countries :global(li)::before { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--w); background: rgba(255, 255, 255, .07); }
  .jd-countries :global(span), .jd-countries :global(b) { position: relative; }
  .jd-countries :global(span) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--jd-text-2); }
  .jd-countries :global(b) { font-weight: 600; font-variant-numeric: tabular-nums; color: var(--jd-text); }

  .jd-drawer-links { display: flex; gap: 18px; padding: 8px 4px; }
  .jd-drawer-links a { font-size: 14px; }
</style>
