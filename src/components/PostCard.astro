---
import MacWindow from './MacWindow.astro';
import { type Post, postHref, postLang, splitTitle, nbHyphen, formatDate, extractCover } from '../lib/posts';
import { catOf, subLabel } from '../lib/site';
// hl: 카드 제목의 제목 단계 — 목록 페이지는 h1 바로 아래라 2, 홈은 섹션 h2 아래라 3
// eyebrow: 머리말 — 페이지가 이미 거른 분류는 되풀이하지 않는다 (대분류 페이지는 소분류만, 소분류 페이지는 없음)
// lead: 목록 첫 칸 — 두 칸×두 줄로 크게 (PagedGrid 가 정하고, 거르면 스크립트가 옮긴다)
interface Props { post: Post; hidden?: boolean; page?: number; lead?: boolean; hl?: 2 | 3; eyebrow?: 'full' | 'sub' | 'none' }
const { post, hidden = false, page, lead = false, hl = 3, eyebrow = 'full' } = Astro.props;
const lang = postLang(post);
const { title, description, category, subcategory, pubDate } = post.data;
const { main, sub } = splitTitle(title);
const cat = catOf(category);
const win = extractCover(post.body)?.front;
const href = postHref(post);
const H = `h${hl}` as 'h2' | 'h3';
const subName = subLabel(category, subcategory, lang);
---
<article
  class:list={['jd-card', 'jd-rise', { 'is-lead': lead }]}
  style={cat ? `--jd-tint:${cat.tint};--jd-acc:${cat.acc}` : undefined}
  data-page={page}
  data-cat={cat?.slug}
  hidden={hidden}
>
  <a class="jd-card-link" href={href}>
    <div class="jd-card-thumb">
      {win ? <MacWindow win={win} size="sm" /> : <span class="jd-tile">{nbHyphen(sub ? main : subName)}</span>}
    </div>
    <div class="jd-card-body">
      {eyebrow !== 'none' && <span class="jd-eyebrow">{eyebrow === 'sub' ? subName : `${category} · ${subName}`}</span>}
      {/* 제목은 두 줄, 부제·요약은 각각 두 줄까지 보이고 넘치면 말줄임 */}
      <H class="jd-card-title">
        {sub ? (
          win ? <><span class="jd-card-main">{nbHyphen(main)}</span><span class="jd-card-sub">{sub}</span></>
              : <><span class="jd-sr">{main} — </span><span class="jd-card-main">{sub}</span></>
        ) : <span class="jd-card-main">{nbHyphen(title)}</span>}
      </H>
      {description && <p class="jd-card-desc">{description}</p>}
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
    </div>
  </a>
</article>
<style>
  .jd-card {
    display: flex; flex-direction: column; overflow: hidden; border-radius: var(--jd-r);
    background: var(--jd-glass); border: 1px solid var(--jd-glass-line); box-shadow: var(--jd-glass-hi);
    -webkit-backdrop-filter: var(--jd-blur); backdrop-filter: var(--jd-blur);
    transition: transform .6s var(--jd-spring), border-color .6s, background .6s;
  }
  .jd-card[hidden] { display: none; }
  @media (hover: hover) { .jd-card:hover { transform: scale(1.012) !important; border-color: var(--jd-glass-line-2); background: var(--jd-glass-2); } } /* 터치 기기에선 누르면 hover 가 같이 켜져 커졌다 줄어든다 */
  @media (prefers-reduced-motion: no-preference) { .jd-card:active { transform: scale(.985) !important; transition-duration: .15s; } } /* 누름 — 떠오르기 효과를 이기려고 hover 처럼 !important */
  .jd-card-link { display: flex; flex-direction: column; flex: 1; color: inherit; }
  .jd-card-link:hover { text-decoration: none; }
  .jd-card-thumb {
    display: flex; align-items: flex-end; justify-content: center; aspect-ratio: 16 / 9; overflow: hidden;
    padding: 22px 22px 0; background: var(--jd-tint, var(--jd-fill-2));
    border-bottom: 1px solid var(--jd-line);
  }
  .jd-tile { align-self: flex-end; width: 100%; padding: 0 6px 24px; font-size: 28px; line-height: 1.14; font-weight: 700; letter-spacing: -.025em; color: var(--jd-text); }
  .jd-card-body { display: flex; flex-direction: column; flex: 1; padding: 22px 28px 26px; }
  .jd-eyebrow { margin: 0 0 8px; font-size: 12px; font-weight: 600; letter-spacing: .02em; color: var(--jd-acc, var(--jd-text-2)); }
  /* 분류 색은 어두운 바탕용이라 흰 바탕에서는 어둡게 섞어 글자 대비를 맞춘다 */
  :global([data-theme='light']) .jd-eyebrow { color: color-mix(in oklab, var(--jd-acc, var(--jd-text-2)) 55%, #000); }
  .jd-card-title { margin: 0 0 10px; font-size: 19px; line-height: 1.38; letter-spacing: -.015em; color: var(--jd-text); }
  .jd-card-main, .jd-card-sub, .jd-card-desc { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .jd-card-main { font-weight: 700; text-wrap: balance; }
  .jd-card-sub { margin-top: 4px; font-size: 15px; line-height: 1.4; font-weight: 500; color: var(--jd-text-2); }
  .jd-card-desc { flex: 1; margin: 0 0 14px; font-size: 14.5px; line-height: 1.6; color: var(--jd-text-3); }
  .jd-card time { margin-top: auto; font-size: 14px; color: var(--jd-text-3); }

  /* 첫 칸 — 두 칸×두 줄. 표지 창이 칸을 채우고 창 속 글자도 큰 창 크기로 */
  @media (min-width: 761px) {
    .jd-card.is-lead { grid-column: span 2; grid-row: span 2; }
    .jd-card.is-lead .jd-card-thumb { flex: 1; aspect-ratio: auto; min-height: 320px; padding: 40px 48px 0; background: radial-gradient(90% 120% at 0% 0%, color-mix(in srgb, var(--jd-acc, #2997FF) 30%, transparent), transparent 70%), var(--jd-tint, var(--jd-fill-2)); }
    .jd-card.is-lead :global(.jd-win.is-sm) { border-radius: 16px 16px 0 0; }
    .jd-card.is-lead :global(.jd-win.is-sm .jd-win-bar) { padding: 12px 16px; gap: 8px; }
    .jd-card.is-lead :global(.jd-win.is-sm .jd-win-bar i) { width: 12px; height: 12px; }
    .jd-card.is-lead :global(.jd-win.is-sm .jd-win-name) { font-size: 12px; }
    .jd-card.is-lead :global(.jd-win.is-sm .jd-win-body) { padding: 20px 22px; font-size: 13px; line-height: 1.7; }
    .jd-card.is-lead .jd-card-body { flex: none; padding: 30px 40px 34px; }
    .jd-card.is-lead .jd-card-title { font-size: clamp(24px, 2.4vw, 32px); line-height: 1.2; letter-spacing: -.025em; }
    .jd-card.is-lead .jd-card-sub { font-size: 18px; }
    .jd-card.is-lead .jd-card-desc { font-size: 16px; -webkit-line-clamp: 2; }
    .jd-card.is-lead .jd-tile { font-size: 44px; }
  }
</style>
