---
import MacWindow from './MacWindow.astro';
import { type Post, postHref, postLang, splitTitle, nbHyphen, formatDate, extractCover } from '../lib/posts';
import { catOf, subLabel } from '../lib/site';
interface Props { post: Post; hidden?: boolean; page?: number }
const { post, hidden = false, page } = Astro.props;
const lang = postLang(post);
const { title, category, subcategory, pubDate } = post.data;
const { main, sub } = splitTitle(title);
const cat = catOf(category);
const win = extractCover(post.body)?.front;
const href = postHref(post);
---
<article
  class="jd-card jd-rise"
  style={cat ? `--jd-tint:${cat.tint};--jd-acc:${cat.acc}` : undefined}
  data-page={page}
  hidden={hidden}
>
  <a class="jd-card-link jd-pan-host" href={href}>
    <span class="jd-card-thumb">
      {win ? <MacWindow win={win} size="sm" /> : <span class="jd-tile">{nbHyphen(sub ? main : subLabel(category, subcategory, lang))}</span>}
    </span>
    <span class="jd-card-body">
      <span class="jd-eyebrow">{category} · {subLabel(category, subcategory, lang)}</span>
      {/* 제목 줄은 마우스가 있는 기기에서 한 줄로 자르고, 카드에 마우스를 올리면 옆으로 흘러 끝까지 보인다 (global.css 의 .jd-pan) */}
      <span class="jd-card-title">
        {sub ? (
          win ? <><strong class="jd-pan"><span class="jd-pan-in">{nbHyphen(main)}</span></strong><span class="jd-card-sub jd-pan"><span class="jd-pan-in">{sub}</span></span></>
              : <><span class="jd-sr">{main} — </span><strong class="jd-pan"><span class="jd-pan-in">{sub}</span></strong></>
        ) : <strong class="jd-pan"><span class="jd-pan-in">{nbHyphen(title)}</span></strong>}
      </span>
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
    </span>
  </a>
</article>
<style>
  .jd-card {
    display: flex; flex-direction: column; overflow: hidden; border-radius: var(--jd-r);
    background: var(--jd-glass); border: 1px solid var(--jd-glass-line); box-shadow: var(--jd-glass-hi);
    -webkit-backdrop-filter: var(--jd-blur); backdrop-filter: var(--jd-blur);
    transition: transform .6s var(--jd-spring), border-color .6s, background .6s;
  }
  .jd-card[hidden] { display: none; }
  .jd-card:hover { transform: scale(1.012) !important; border-color: var(--jd-glass-line-2); background: var(--jd-glass-2); }
  @media (prefers-reduced-motion: no-preference) { .jd-card:active { transform: scale(.985) !important; transition-duration: .15s; } } /* 누름 — 떠오르기 효과를 이기려고 hover 처럼 !important */
  .jd-card-link { display: flex; flex-direction: column; flex: 1; color: inherit; }
  .jd-card-link:hover { text-decoration: none; }
  .jd-card-thumb {
    display: flex; align-items: flex-end; justify-content: center; aspect-ratio: 16 / 9; overflow: hidden;
    padding: 22px 22px 0; background: var(--jd-tint, rgba(255, 255, 255, .06));
    border-bottom: 1px solid rgba(255, 255, 255, .08);
  }
  .jd-tile { align-self: flex-end; width: 100%; padding: 0 6px 24px; font-size: 28px; line-height: 1.14; font-weight: 700; letter-spacing: -.025em; color: #F5F5F7; }
  .jd-card-body { display: flex; flex-direction: column; flex: 1; padding: 22px 28px 26px; }
  .jd-eyebrow { margin: 0 0 8px; font-size: 12px; font-weight: 600; letter-spacing: .02em; color: var(--jd-acc, var(--jd-text-2)); }
  .jd-card-title { flex: 1; margin: 0 0 10px; font-size: 19px; line-height: 1.38; letter-spacing: -.015em; color: var(--jd-text); }
  .jd-card-title strong { display: block; font-weight: 700; }
  .jd-card-sub { display: block; margin-top: 4px; font-size: 15px; line-height: 1.4; font-weight: 500; color: var(--jd-text-2); }
  .jd-card time { font-size: 14px; color: var(--jd-text-3); }
</style>
