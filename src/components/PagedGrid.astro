---
/**
 * 글 카드 그리드 + 페이지 번호.
 * 카드는 전부 빌드 때 넣어 두고, 번호를 누르면 이 그리드만 바뀐다 (위쪽 히어로·새 글은 그대로).
 * 주소는 ?p=N — 뒤로 가기가 동작하고, 그 주소로 바로 들어와도 같은 쪽이 열린다.
 */
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';
import { SITE } from '../lib/site';
import { langOf, ui } from '../lib/i18n';
const t = ui(langOf(Astro.url));
// shelf: 폰에서 첫 쪽 카드를 옆으로 넘기는 가로 진열로 보여 주고 페이지 번호는 숨긴다 (홈 전용)
// hl·eyebrow 는 카드(PostCard)에 그대로 넘긴다
interface Props { posts: Post[]; anchor?: string; perPage?: number; shelf?: boolean; hl?: 2 | 3; eyebrow?: 'full' | 'sub' | 'none' }
const { posts, anchor, perPage = SITE.perPage, shelf = false, hl, eyebrow } = Astro.props;
const pages = Math.max(1, Math.ceil(posts.length / perPage));
---
<div class:list={['jd-paged', { 'is-shelf': shelf }]} data-pages={pages} data-per={perPage} data-anchor={anchor}>
  <div class="jd-grid">
    {posts.map((p, i) => <PostCard post={p} page={Math.floor(i / perPage) + 1} hidden={i >= perPage} hl={hl} eyebrow={eyebrow} />)}
  </div>
  {pages > 1 && (
    <nav class="jd-pager" aria-label={t.pager}>
      <a class="jd-pager-prev jd-off" href="?p=1" data-go="prev" aria-label={t.prevPage} aria-disabled="true" tabindex="-1">‹</a>
      {Array.from({ length: pages }, (_, i) => (
        <a href={`?p=${i + 1}`} data-p={i + 1} aria-current={i === 0 ? 'page' : undefined}>{i + 1}</a>
      ))}
      <a class="jd-pager-next" href="?p=2" data-go="next" aria-label={t.nextPage}>›</a>
    </nav>
  )}
</div>

<script>
  // 쪽 넘김 + 주제 거르기. 거르기는 전체 글 페이지의 주제 칩이 보내는 jd:filter 이벤트(주제 주소 이름, 비우면 전체)로 한다.
  // 거르면 남은 카드로 쪽을 다시 나누고, 주소에 ?cat= 을 남겨 뒤로 가기·새로 고침에도 그대로 보인다
  document.querySelectorAll<HTMLElement>('.jd-paged').forEach((root) => {
    const per = Number(root.dataset.per);
    const cards = [...root.querySelectorAll<HTMLElement>('.jd-card')];
    const pager = root.querySelector<HTMLElement>('.jd-pager');
    const links = [...root.querySelectorAll<HTMLAnchorElement>('.jd-pager a[data-p]')];
    const prev = root.querySelector<HTMLAnchorElement>('[data-go="prev"]');
    const next = root.querySelector<HTMLAnchorElement>('[data-go="next"]');
    const anchor = root.dataset.anchor ? document.getElementById(root.dataset.anchor) : root;
    let items = cards;
    let pages = Number(root.dataset.pages);

    function show(p: number, scroll: boolean) {
      p = Math.min(Math.max(1, p), pages);
      cards.forEach((c) => (c.hidden = true));
      items.slice((p - 1) * per, p * per).forEach((c) => (c.hidden = false));
      if (pager && prev && next) {
        pager.hidden = pages < 2;
        links.forEach((a) => {
          const n = Number(a.dataset.p);
          a.hidden = n > pages;
          if (n === p) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
        });
        // 끝 쪽의 이전·다음은 흐리게 두고, 키보드로도 닿지 않게 한다
        for (const [a, off] of [[prev, p === 1], [next, p === pages]] as const) {
          a.classList.toggle('jd-off', off);
          if (off) { a.setAttribute('aria-disabled', 'true'); a.tabIndex = -1; } else { a.removeAttribute('aria-disabled'); a.removeAttribute('tabindex'); }
        }
        prev.href = `?p=${p - 1}`;
        next.href = `?p=${p + 1}`;
      }
      if (scroll) anchor?.scrollIntoView({ block: 'start' });
    }
    const params = () => new URLSearchParams(location.search);
    const cur = () => Number(params().get('p')) || 1;
    function filter(cat: string) {
      items = cat ? cards.filter((c) => c.dataset.cat === cat) : cards;
      pages = Math.max(1, Math.ceil(items.length / per));
    }
    const go = (p: number, cat: string | null, push: boolean) => {
      const url = new URL(location.href);
      if (cat !== null) { if (cat) url.searchParams.set('cat', cat); else url.searchParams.delete('cat'); }
      if (p <= 1) url.searchParams.delete('p'); else url.searchParams.set('p', String(p));
      history[push ? 'pushState' : 'replaceState']({ p }, '', url);
    };

    pager?.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a');
      if (!a) return;
      e.preventDefault();
      const p = a.dataset.p ? Number(a.dataset.p) : cur() + (a.dataset.go === 'next' ? 1 : -1);
      go(p, null, true);
      show(p, true);
    });
    document.addEventListener('jd:filter', (e) => {
      const cat = (e as CustomEvent<string>).detail;
      filter(cat);
      go(1, cat, true);
      show(1, false);
    });
    window.addEventListener('popstate', () => { filter(params().get('cat') ?? ''); show(cur(), true); });
    const cat0 = params().get('cat');
    if (cat0) filter(cat0);
    if (cat0 || cur() !== 1) show(cur(), false);
  });
</script>

<style>
  .jd-pager { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 6px; margin: 44px 0 0; }
  .jd-pager a {
    display: inline-flex; align-items: center; justify-content: center; min-width: 44px; height: 44px; padding: 0 6px;
    border-radius: 980px; font: 500 15px var(--jd-font); color: var(--jd-text-2); transition: background .2s, color .2s;
  }
  .jd-pager a:hover { background: var(--jd-fill-2); color: var(--jd-text); text-decoration: none; }
  .jd-pager a[aria-current='page'] { background: var(--jd-text); color: var(--jd-on-ink); font-weight: 600; }
  .jd-pager a.jd-off { opacity: .3; pointer-events: none; }
  .jd-pager[hidden], .jd-pager a[hidden] { display: none; }
  @media (max-width: 760px) {
    .is-shelf .jd-grid {
      display: flex; gap: 12px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
      margin: 0 calc(var(--jd-gutter) * -1); padding: 2px var(--jd-gutter) 8px; scroll-padding-inline: var(--jd-gutter);
      scrollbar-width: none;
    }
    .is-shelf .jd-grid::-webkit-scrollbar { display: none; }
    /* 떠오르는 효과는 옆으로 넘길 때 어색하므로 가로 진열에서는 끈다 */
    .is-shelf .jd-grid > :global(.jd-card) { flex: 0 0 84%; scroll-snap-align: start; animation: none; opacity: 1; }
    .is-shelf .jd-pager { display: none; }
  }
</style>
