---
import { SITE, NAV } from '../lib/site';
import { langOf, localize, ui } from '../lib/i18n';
interface Props { switchTo: string } // 다른 언어판의 같은 페이지
const { switchTo } = Astro.props;
const lang = langOf(Astro.url);
const t = ui(lang);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<nav class="jd-gnav" aria-label={t.navLabel}>
  <a class="jd-gnav-logo" href={localize('/', lang)}><img src="/avatar.webp" alt="" width="34" height="34" /><span>{SITE.title}</span></a>
  <div class="jd-gnav-more"><div class="jd-gnav-more-in">
  <ul class="jd-gnav-links">
    {NAV.map((n) => <li><a href={localize(n.href, lang)} aria-current={isActive(localize(n.href, lang)) ? 'page' : undefined}>{t[n.key]}</a></li>)}
  </ul>
  <a class="jd-gnav-lang" href={switchTo} hreflang={lang === 'en' ? 'ko' : 'en'} aria-label={t.otherLang}><span>{t.otherLangShort}</span></a>
  <form class="jd-gnav-search" action={localize('/search', lang)} method="get" role="search">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 21 21"></path></svg>
    <input type="search" name="q" placeholder={t.search} aria-label={t.searchAria} autocomplete="off" data-cmdk-open />
    <kbd class="jd-gnav-kbd" aria-hidden="true">⌘K</kbd>
  </form>
  </div></div>
  {/* 오른쪽 끝 단추 — 검색과 메뉴. 넓은 화면은 검색창이 있어 검색 단추는 숨는다. 바가 접히면 링크와 함께 접혀 로고만 남는다 */}
  <div class="jd-gnav-fixed"><div class="jd-gnav-fixed-in">
    <a class="jd-gnav-icon jd-gnav-search-m" href={localize('/search', lang)} aria-label={t.search} data-cmdk-open>
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 21 21"></path></svg>
    </a>
    <button type="button" class="jd-gnav-icon" data-drawer-open aria-label={t.menuOpen} aria-controls="jd-drawer" aria-expanded="false">
      <svg width="18" height="13" viewBox="0 0 20 14" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M0 0h20v2H0V0zm0 6h20v2H0V6zm0 6h20v2H0v-2z"></path></svg>
    </button>
  </div></div>
</nav>

<script>
  // 스크롤을 내리면 로고만 남긴 작은 캡슐로 접고, 맨 위로 돌아오면 다시 편다
  const nav = document.querySelector<HTMLElement>('.jd-gnav')!;
  const canHover = matchMedia('(hover: hover)');
  const sync = () => {
    nav.classList.toggle('is-compact', scrollY > 80);
    nav.classList.remove('is-open');
  };
  addEventListener('scroll', sync, { passive: true });
  sync();
  // 터치 기기에는 hover 가 없으므로 접힌 상태의 첫 탭은 메뉴를 펼치는 데 쓴다.
  // 탭하면 링크에 포커스가 먼저 들어가므로 접힘 여부는 click 이 아닌 pointerdown 시점에 판단한다
  let folded = false;
  nav.addEventListener('pointerdown', () => {
    folded = !canHover.matches && nav.classList.contains('is-compact') && !nav.classList.contains('is-open') && !nav.matches(':focus-within');
  });
  nav.addEventListener('click', (e) => {
    if (!folded) return;
    folded = false;
    e.preventDefault();
    e.stopPropagation();
    // 탭으로 생긴 포커스가 남으면 :focus-within 때문에 스크롤해도 접히지 않는다
    (document.activeElement as HTMLElement | null)?.blur();
    nav.classList.add('is-open');
  }, true);
  document.addEventListener('click', (e) => {
    if (!nav.contains(e.target as Node)) nav.classList.remove('is-open');
  });

  // 폰에서는 펼친 바가 화면 폭을 다 쓰고 접히면 로고 폭으로 줄어든다. 두 폭이 모두 길이여야 폭이 부드럽게 바뀌므로 접힌 폭을 재어 둔다
  const logo = nav.querySelector<HTMLElement>('.jd-gnav-logo')!;
  const more = nav.querySelector<HTMLElement>('.jd-gnav-more')!;
  const measure = () => {
    const n = getComputedStyle(nav);
    const px = (v: string) => parseFloat(v) || 0;
    const w = logo.offsetWidth + px(getComputedStyle(logo).marginRight) + px(getComputedStyle(more).minWidth)
      + px(n.paddingLeft) + px(n.paddingRight) + px(n.borderLeftWidth) + px(n.borderRightWidth);
    nav.style.setProperty('--jd-gnav-mini', `${Math.ceil(w)}px`);
  };
  // 링크 줄이 넘치면 옆으로 밀어 본다 — 잘린 쪽 끝만 흐리게 해 더 있다는 걸 알린다
  const strip = nav.querySelector<HTMLElement>('.jd-gnav-more-in')!;
  const edges = () => {
    const over = strip.scrollWidth - strip.clientWidth;
    strip.classList.toggle('is-cut-start', strip.scrollLeft > 1);
    strip.classList.toggle('is-cut-end', strip.scrollLeft < over - 1);
  };
  strip.addEventListener('scroll', edges, { passive: true });
  addEventListener('resize', () => { measure(); edges(); });
  document.fonts?.ready.then(() => { measure(); edges(); });
  measure();
  edges();
</script>

<style>
  .jd-gnav {
    position: sticky; top: 14px; z-index: 90;
    display: flex; align-items: center; gap: 6px;
    width: fit-content; max-width: calc(100% - 32px);
    margin: 14px auto 0; padding: 4px 6px 4px 9px;
    border-radius: 980px;
    background: var(--jd-bar);
    -webkit-backdrop-filter: blur(24px) saturate(170%); backdrop-filter: blur(24px) saturate(170%);
    border: 1px solid var(--jd-glass-line);
    box-shadow: var(--jd-glass-hi), 0 10px 30px -12px var(--jd-shadow);
    transform-origin: 50% 0;
    view-transition-name: jd-gnav;
  }
  /* 로고 — 동그란 얼굴 아이콘 + Unbounded 글자 */
  .jd-gnav-logo {
    display: inline-flex; align-items: center; gap: 10px; margin-right: 12px;
    font: 600 15px var(--jd-logo); letter-spacing: -.03em; color: var(--jd-text); white-space: nowrap;
  }
  .jd-gnav-logo img { flex: none; border-radius: 50%; }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .jd-gnav { background: var(--jd-solid); -webkit-backdrop-filter: none; backdrop-filter: none; border-color: var(--jd-glass-line-2); }
  }
  .jd-gnav-logo:hover { text-decoration: none; }
  /* 접힘 영역 — grid 열을 1fr ↔ 0fr 로 바꿔 내용 폭만큼 부드럽게 줄인다. 높이는 그대로 두어 아래 레이아웃이 밀리지 않게 한다.
     padding/음수 margin 은 overflow 로 포커스 링이 잘리지 않게 하는 여유 공간 */
  .jd-gnav-more { display: grid; grid-template-columns: 1fr; min-width: 6px; }
  .jd-gnav-more-in {
    display: flex; align-items: center; gap: 6px;
    min-width: 0; overflow: hidden;
    padding: 6px; margin: -6px;
  }
  /* 접힘 — 마우스를 올리거나(hover 기기) 탭하거나(터치 기기, .is-open) 키보드 포커스가 들어오면 원래대로 */
  /* 접히면 로고만 남으니 사이 간격도 걷어, 글자 오른쪽 여백을 폰과 같은 16px(4 + 6 + 6)로 */
  @media (hover: hover) {
    .jd-gnav.is-compact:not(:hover, :focus-within) { transform: scale(.92); gap: 0; }
    .jd-gnav.is-compact:not(:hover, :focus-within) .jd-gnav-logo { margin-right: 4px; }
    .jd-gnav.is-compact:not(:hover, :focus-within) :is(.jd-gnav-more, .jd-gnav-fixed) { grid-template-columns: 0fr; opacity: 0; }
  }
  @media (hover: none) {
    .jd-gnav.is-compact:not(.is-open, :focus-within) { transform: scale(.92); gap: 0; }
    .jd-gnav.is-compact:not(.is-open, :focus-within) .jd-gnav-logo { margin-right: 4px; }
    .jd-gnav.is-compact:not(.is-open, :focus-within) :is(.jd-gnav-more, .jd-gnav-fixed) { grid-template-columns: 0fr; opacity: 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .jd-gnav { transition: transform .5s var(--jd-spring), width .5s var(--jd-ease-out), gap .5s var(--jd-ease-out); }
    .jd-gnav-logo { transition: margin .5s var(--jd-ease-out); }
    :is(.jd-gnav-more, .jd-gnav-fixed) { transition: grid-template-columns .5s var(--jd-ease-out), opacity .35s var(--jd-ease); }
  }
  .jd-gnav-links { display: flex; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .jd-gnav-links a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px;
    font-size: 14px; color: color-mix(in srgb, var(--jd-text) 82%, transparent);
    border-radius: 980px; transition: color .2s, background .2s; white-space: nowrap;
  }
  .jd-gnav-links a:hover { color: var(--jd-text); background: var(--jd-fill-2); text-decoration: none; }
  .jd-gnav-links a[aria-current='page'] { color: var(--jd-text); background: var(--jd-fill-3); } /* 지금 있는 곳 — 밝기만이 아니라 면으로도 */
  /* 언어 전환 — 누르는 자리는 44px, 보이는 건 작은 테두리 상자 */
  .jd-gnav-lang {
    display: inline-flex; align-items: center; justify-content: center; min-width: 44px; height: 44px;
    font-size: 11.5px; font-weight: 700; letter-spacing: .04em; color: color-mix(in srgb, var(--jd-text) 82%, transparent); white-space: nowrap;
  }
  .jd-gnav-lang span { padding: 3px 7px; border: 1px solid var(--jd-glass-line-2); border-radius: 7px; transition: border-color .2s, color .2s; }
  .jd-gnav-lang:hover { color: var(--jd-text); text-decoration: none; }
  .jd-gnav-lang:hover span { border-color: color-mix(in srgb, var(--jd-text) 60%, transparent); }
  .jd-gnav-search { position: relative; margin: 0 0 0 6px; }
  .jd-gnav-search input {
    width: 132px; height: 36px; padding: 0 14px 0 34px;
    border-radius: 980px; border: 1px solid transparent;
    background: var(--jd-fill-2); color: var(--jd-text); font: 14px var(--jd-font);
    outline: none; transition: background .2s, border-color .2s; /* 폭은 애니메이션하지 않는다 — 레이아웃을 매 프레임 다시 계산하게 된다 */
    -webkit-appearance: none; appearance: none;
  }
  .jd-gnav-search input::-webkit-search-cancel-button { display: none; }
  .jd-gnav-search input::placeholder { color: var(--jd-text-3); }
  .jd-gnav-search input:focus { width: 200px; background: var(--jd-fill-3); border-color: rgba(41, 151, 255, .6); }
  .jd-gnav-search svg { position: absolute; left: 12px; color: var(--jd-text-3); top: 50%; transform: translateY(-50%); pointer-events: none; }
  /* 검색 창 단축키 안내 — 마우스·키보드 기기에서만 */
  .jd-gnav-kbd {
    position: absolute; right: 8px; top: 50%; transform: translateY(-50%); pointer-events: none;
    padding: 1px 6px; border-radius: 6px; border: 1px solid var(--jd-glass-line); font: 600 11px var(--jd-font); color: var(--jd-text-3);
  }
  @media (hover: none) { .jd-gnav-kbd { display: none; } }
  .jd-gnav-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; margin: 0; padding: 0; border: 0; border-radius: 50%;
    background: transparent; color: var(--jd-text); cursor: pointer; transition: background .2s;
  }
  .jd-gnav-icon:hover { background: var(--jd-fill-2); }
  .jd-gnav-fixed { display: grid; grid-template-columns: 1fr; }
  .jd-gnav-fixed-in { display: flex; align-items: center; min-width: 0; overflow: hidden; }
  .jd-gnav-search-m { display: none; }
  @media (max-width: 760px) {
    .jd-gnav { padding-left: 7px; gap: 0; }
    .jd-gnav-more-in { gap: 0; }
    .jd-gnav-logo { gap: 8px; margin-right: 4px; font-size: 13.5px; }
    .jd-gnav-logo img { width: 32px; height: 32px; }
    .jd-gnav-links a { padding: 0 9px; font-size: 13px; }
    .jd-gnav-search { display: none; }
    .jd-gnav-search-m { display: inline-flex; }
    /* 펼친 바는 화면 폭을 다 쓰고, 링크 줄이 남는 폭을 차지한다. 넘치면 손가락으로 옆으로 민다 */
    .jd-gnav { width: calc(100% - 32px); }
    .jd-gnav-more { flex: 1; }
    /* 왼쪽은 로고에 붙지 않게 음수 여백을 빼고, 밀려 나간 글자는 로고 앞에서 완전히 사라지게 흐린다 */
    .jd-gnav-more-in { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; margin-left: 0; padding-left: 4px; }
    .jd-gnav-more-in::-webkit-scrollbar { display: none; }
    .jd-gnav-more-in.is-cut-end { -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent); }
    .jd-gnav-more-in.is-cut-start { -webkit-mask-image: linear-gradient(90deg, transparent 6px, #000 34px); mask-image: linear-gradient(90deg, transparent 6px, #000 34px); }
    .jd-gnav-more-in.is-cut-start.is-cut-end { -webkit-mask-image: linear-gradient(90deg, transparent 6px, #000 34px, #000 calc(100% - 28px), transparent); mask-image: linear-gradient(90deg, transparent 6px, #000 34px, #000 calc(100% - 28px), transparent); }
  }
  /* 접힌 바는 로고 폭 (재어 둔 --jd-gnav-mini) */
  @media (max-width: 760px) and (hover: hover) { .jd-gnav.is-compact:not(:hover, :focus-within) { width: var(--jd-gnav-mini, fit-content); } }
  @media (max-width: 760px) and (hover: none) { .jd-gnav.is-compact:not(.is-open, :focus-within) { width: var(--jd-gnav-mini, fit-content); } }
</style>
